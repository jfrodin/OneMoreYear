<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OneMoreYear.Simulation</RootNamespace>
  </PropertyGroup>

  <!-- Game content (traits, countries, occupations, events) lives in /content at the repo root
       and is embedded in the assembly so every frontend gets the same data. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\content\**\*.json" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneMoreYear.Simulation.Tests" />
  </ItemGroup>

</Project>

      "failure": { "text": "Caught. Fifty push ups each, in the rain. He buys you a beer on Friday.", "effects": [ { "type": "attribute", "kind": "fitness", "amount": 1 }, { "type": "performance", "amount": -2 } ] } } ] },
  { "event": "nt_police_first_call", "choices": [ { "text": "Wait for backup", "effects": [ { "type": "performance", "amount": -2 } ], "result": "Six long minutes. When you go in, it is calm, and you never know whether it would have been calm anyway." } ] },
  { "event": "old_fall", "choices": [ { "text": "Shout until a neighbour hears", "chance": 0.6,

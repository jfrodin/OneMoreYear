      "failure": { "text": "Nobody hears for a long time. It is morning before the home help comes.", "effects": [ { "type": "health", "amount": -10 }, { "type": "happiness", "amount": -6 } ] } } ] },
  { "event": "old_great_grandchild", "choices": [ { "text": "Ask someone else to hold the baby", "effects": [ { "type": "happiness", "amount": 4 } ], "result": "Your arms are not what they were. You sit very close instead, and the baby holds your finger for the whole photo." } ] },
  { "event": "parent_first_word", "choices": [ { "text": "Keep it to yourself", "effects": [ { "type": "happiness", "amount": 6 } ], "result": "Nobody else heard it. For one day it is yours alone. By the weekend everyone has heard it twenty times." } ] },
  { "event": "parent_graduation", "choices": [ { "text": "Hold it together, for their sake", "effects": [ { "type": "happiness", "amount": 6 } ], "result": "You manage until the speech. Then nobody is holding anything together." } ] },
  { "event": "parent_grandchild_news", "choices": [ { "text": "Go very quiet", "effects": [ { "type": "happiness", "amount": 8 } ], "result": "You cannot say anything at all. You hold the socks, and then you hold {t.name}, for a long time." } ] },
  { "event": "pol_election_night", "choices": [ { "text": "Go home and sleep", "chance": 0.6,

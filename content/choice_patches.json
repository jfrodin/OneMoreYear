  { "event": "us2_snow_day", "choices": [ { "text": "Get dressed for school anyway", "effects": [ { "type": "grades", "amount": 1 } ], "result": "Ready by the door, coat on. Then your school is read out, and the coat comes off with a cheer." } ] },

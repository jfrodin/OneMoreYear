  { "event": "tod_grandma_lap", "choices": [ { "text": "Sing it to her instead", "effects": [ { "type": "happiness", "amount": 4 } ], "result": "You get every word wrong. She laughs so much she has to wipe her eyes." } ] },
  { "event": "us_college_letters", "choices": [ { "text": "Open them alone in your room", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "Whatever they say, you get five minutes with it before anyone else does." } ] },
  { "event": "us_credit_score", "choices": [ { "text": "Ask what you can do to raise it", "effects": [ { "type": "trait_add", "trait": "stingy", "chance": 0.04 } ], "result": "A list: pay on time, close nothing, wait. You put it on the fridge, and it works, slowly." } ] },
  { "event": "us_little_league", "choices": [ { "text": "Do not try out", "effects": [ { "type": "happiness", "amount": -1 } ], "result": "You watch the games from the bleachers. It is fine. Next summer, maybe." } ] },

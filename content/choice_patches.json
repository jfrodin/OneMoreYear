[
  { "event": "act_stage_fright", "choices": [ { "text": "Ask the understudy to go on", "effects": [ { "type": "fame", "amount": -2 }, { "type": "happiness", "amount": -4 } ], "result": "You watch from the wings while someone else says your lines, not as well. Nobody in the audience knows. You do." } ] },
  { "event": "adult_car_crash", "choices": [ { "text": "Steer into the skid", "chance": 0.55, "chanceAttributes": { "fitness": 0.003 },
      "success": { "text": "The car straightens, slides, and stops a metre from the ditch. You sit there with the engine running until your hands stop shaking.", "effects": [ { "type": "happiness", "amount": 2 } ] },
      "failure": { "text": "It spins anyway. The ditch, the airbag, glass in your hair. You walk away from it, just.", "effects": [ { "type": "health", "amount": -10 }, { "type": "money", "amount": -20000 } ] } } ] },
  { "event": "adult_lottery", "choices": [ { "text": "Give it to the cashier for luck", "effects": [ { "type": "happiness", "amount": 2 } ], "result": "She laughs and scratches it on the counter. Nothing. She gives you a free coffee instead." } ] },
  { "event": "business_review", "choices": [ { "text": "Do not read it", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "You never read it. The customers who come in mention it, though, and you can tell from their faces which kind it was." } ] },
  { "event": "child_birthday_party", "choices": [ { "text": "Start eating the cake", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "If nobody comes, there is more cake. Then the doorbell rings, and rings again, and your mouth is full of cake when they sing." } ] },
  { "event": "ev_lottery_ticket", "choices": [ { "text": "Put it away and check tomorrow", "effects": [ { "type": "money", "amount": 1500 }, { "type": "happiness", "amount": 2 } ], "result": "A whole night of being almost rich. In the morning it is four numbers and a small win, and the night was worth more than the money." } ] },
  { "event": "fame_fading", "choices": [ { "text": "Tell them who you were", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "They look it up on the spot, politely impressed, and you wish you had not." } ] },
  { "event": "gp_grandparent_wisdom", "choices": [ { "text": "Say you will hear it another time", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": -2 } ], "result": "{t.name} nods and looks out at the garden. There is not another time, as it turns out." } ] },
  { "event": "gp_great_grandchild", "choices": [ { "text": "Ask for a second one, everyone laughing", "effects": [ { "type": "flag", "flag": "gp_four_generations" }, { "type": "happiness", "amount": 8 } ], "result": "The second one is better: the baby has grabbed your glasses and everyone is laughing. That is the one that ends up on the wall." } ] },
  { "event": "hb_mole", "choices": [ { "text": "Wait and see", "chance": 0.85,
      "success": { "text": "It stays the same. Probably nothing. You check it every month for a year.", "effects": [ { "type": "happiness", "amount": -1 } ] },
      "failure": { "text": "It changes again. This time the doctor uses a different voice. An operation, and a scar, and you were lucky.", "effects": [ { "type": "health", "amount": -12 }, { "type": "happiness", "amount": -6 } ] } } ] },
  { "event": "hob_chess_tournament", "choices": [ { "text": "Play for a draw and the experience", "effects": [ { "type": "skill", "kind": "chess", "amount": 1 }, { "type": "happiness", "amount": 2 } ], "result": "Four draws, two losses, one win against a nine year old who cries. You learn more than in a year at the club." } ] },
  { "event": "hol_mothers_day_card", "choices": [ { "text": "Ask {t.name} to explain the drawing", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 3, "mutual": true }, { "type": "happiness", "amount": 4 } ], "result": "A ten minute explanation. The long arms are for hugging. You will remember that sentence when you are very old." } ] },
  { "event": "hol_name_day", "choices": [ { "text": "Say you are too old for this", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "Everyone ignores you and sings anyway. You eat two pieces." } ] },
  { "event": "job_school_trip_disaster", "choices": [ { "text": "Call the police straight away", "effects": [ { "type": "performance", "amount": 2 }, { "type": "happiness", "amount": -2 } ], "result": "Ten minutes later, the missing child walks out of the gift shop with a plastic dinosaur. The police are kind about it. The head teacher is less kind." } ] },
  { "event": "life_lost_wallet", "choices": [ { "text": "Cancel everything and move on", "effects": [ { "type": "money", "amount": -500 }, { "type": "happiness", "amount": -2 } ], "result": "A morning on the phone, new cards in a week. The photo is gone, though. That is the part that stays with you." } ] },
  { "event": "life_tax_refund", "choices": [ { "text": "Leave it unopened until the weekend", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "Four days of worrying. Then you open it, and it is fine, and you feel silly about the four days." } ] },
  { "event": "lo_why_sky", "choices": [ { "text": "Ask a different grown up", "effects": [ { "type": "attribute", "kind": "smarts", "amount": 1 } ], "result": "A grandparent explains the sky with a torch and a glass of water. It is the best answer you get all year." } ] },
  { "event": "mid_child_inventor", "choices": [ { "text": "Show it to the grown ups first", "effects": [ { "type": "happiness", "amount": 3 } ], "result": "They laugh until they cry, then ask for a demonstration. It almost works. Somebody films it." } ] },
  { "event": "mid_child_spelling_bee", "choices": [ { "text": "Spell it fast before you lose your nerve", "chance": 0.45, "chanceAttributes": { "smarts": 0.006 },
      "success": { "text": "Right. Then right again. You win, and do not quite believe it.", "effects": [ { "type": "grades", "amount": 3 }, { "type": "happiness", "amount": 5 } ] },
      "failure": { "text": "One letter wrong. You knew it. You knew it all the way home.", "effects": [ { "type": "happiness", "amount": -3 } ] } } ] },
  { "event": "mid_child_tooth_fairy", "choices": [ { "text": "Fall asleep like a normal person", "effects": [ { "type": "money", "amount": 20 } ], "result": "A coin in the morning, and no answers. Some mysteries are better left alone." } ] },
  { "event": "nt_military_drill", "choices": [ { "text": "Help the recruit next to you fix his bed", "chance": 0.5,

  { "event": "work_site_accident", "choices": [ { "text": "Let go and shout for help", "effects": [ { "type": "happiness", "amount": -10 } ], "result": "He falls. He lives, with a broken back. You think about your hand letting go for the rest of your life." } ] },
  { "event": "wt2_cabin_turbulence", "choices": [ { "text": "Stay strapped in your seat", "effects": [ { "type": "performance", "amount": -3 } ], "result": "The rules say so. A colleague goes to row eighteen instead. You hear her voice through the noise, steady, and wish it had been yours." } ] },
  { "event": "wt2_salon_regular", "choices": [ { "text": "Do it as usual, and say goodbye at the door", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "The same cut, the same chat, a hug at the door. You do not say what you both know. Maybe that is kinder." } ] }

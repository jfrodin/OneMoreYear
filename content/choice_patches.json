  { "event": "school_nerds_quiz", "choices": [ { "text": "Let someone else take your place", "effects": [ { "type": "happiness", "amount": -1 } ], "result": "They come third. You know you would have got the bird question." } ] },
  { "event": "school_quiet_friend", "choices": [ { "text": "Leave it on the counter", "effects": [], "result": "You are not sure why. The next week the book is gone, and so is the note." } ] },

  "decades": [
    { "year": 1950, "name": "after the war", "text": "The war is over and Sweden was spared. The People's Home is being built: new flats, the first fridges, a car if you are lucky. Most mothers are at home, most fathers at the factory." },
    { "year": 1960, "name": "the record years", "text": "Everyone who wants a job has one. Television arrives, the suburbs grow out of the forest, and the young start to sound different from their parents." },
    { "year": 1970, "name": "the welfare state", "text": "Day care, parental leave and free university. Long hair, protest songs, an oil crisis, and ABBA winning Eurovision." },
    { "year": 1980, "name": "yuppies and video", "text": "Stock market fever, shoulder pads and video shops. Then one night in February 1986, the Prime Minister is shot on a Stockholm street." },
    { "year": 1990, "name": "crisis and the EU", "text": "The krona collapses and interest rates reach 500 percent. Half a million jobs disappear. Sweden joins the European Union, and the internet arrives." },
    { "year": 2000, "name": "everyone online", "text": "Mobile phones in every pocket, the IT bubble bursts, and a wave in Thailand takes hundreds of Swedish lives." },
    { "year": 2010, "name": "smartphones", "text": "Everyone is looking at a screen. Home prices only go one way, and the summers get hotter." },
    { "year": 2020, "name": "the pandemic and after", "text": "Working from the kitchen table, grandparents behind windows, and then a world that will not settle down." },
    { "year": 2030, "name": "the warm decade", "text": "Summers that never seem to end, forest fires in the north, and every car on the street suddenly quiet. Midsummer is moved into the shade." },
    { "year": 2040, "name": "machines that answer", "text": "The machines can talk, write and diagnose. Half of every job is done by something that never sleeps. People argue about what work is for." },
    { "year": 2050, "name": "the long lives", "text": "A hundredth birthday is no longer news. Four generations at every christening, and pensions that have to last forty years." },
    { "year": 2060, "name": "the quiet towns", "text": "The cities grow and the small towns empty. Houses by the lakes sell for a song, and some people buy whole villages." },
    { "year": 2070, "name": "the sea walls", "text": "The water is rising. Gothenburg builds walls, the archipelago loses islands, and the Baltic is warmer than anyone can remember." },
    { "year": 2080, "name": "the great repair", "text": "Forests replanted, rivers set free, roofs covered in grass. A generation decides to fix what its grandparents broke." },
    { "year": 2090, "name": "the century turns", "text": "Children born this decade may see the year 2200. The old talk about the strange world of the 2020s, and nobody believes them." },
    { "year": 2100, "name": "a new century", "text": "Fireworks over a different country: older, warmer, quieter. Some things never change. The queue for the Christmas ham is one of them." },
    { "year": 2110, "name": "the slow years", "text": "Nothing very big happens, and that turns out to be wonderful. People grow vegetables, raise children and argue about the weather." },
    { "year": 2120, "name": "the far fields", "text": "There are people living on the Moon now, a few hundred of them. Some of them are Swedes, and they still celebrate Midsummer, indoors." },
    { "year": 2130, "name": "the old stories", "text": "Every family has a genealogy and an archive of its own. Children know more about their great great grandparents than those people knew about themselves." },
    { "year": 2140, "name": "the second spring", "text": "The forests have come back. Elk wander through what used to be suburbs. The north is green from May to October." },
    { "year": 2150, "name": "the long view", "text": "Two hundred years since the war ended. Historians call the twentieth century the beginning of everything. Your family was there for all of it." },
    { "year": 2160, "name": "the quiet century", "text": "Life is long and mostly gentle. People still fall in love, fall out, have children and wonder what it was all for." },
    { "year": 2170, "name": "one more year", "text": "Another decade, another chapter. Somewhere in a drawer, there is a photograph of the first of you, looking out at a world they could never have imagined." }

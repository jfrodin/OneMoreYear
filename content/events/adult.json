        "failure": {
          "text": "{t.name} smiles, but says {t.he} is seeing someone.",
          "effects": [ { "type": "happiness", "amount": -4 } ]
        }
      },
      {
        "text": "Go home",
        "effects": [],
        "result": "Maybe another time."
      }
    ]
  },
  {
    "id": "adult_child_shoplifting", "oncePerTarget": true, "title": "The police call",
    "text": "{t.role}, {t.name}, has been caught shoplifting.",

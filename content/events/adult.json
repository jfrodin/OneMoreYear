[
  {
    "id": "adult_promotion_move", "title": "The offer",
    "text": "Your boss offers you a promotion – but the position is in another city.",
    "conditions": { "minAge": 22, "maxAge": 60, "hasJob": true }, "cooldown": 8,
    "choices": [
      {
        "text": "Take it",
        "hint": "Your career first. Not everyone will be happy.",
        "effects": [
          { "type": "promote" },
          { "type": "relation", "who": "partner", "to": "player", "dim": "bitterness", "amount": 12 },
          { "type": "memory", "who": "partner", "to": "player", "kind": "moved_for_career", "text": "{name} chose the career and made us move", "impact": -20 }
        ],
        "result": "You pack up your life and start over in a new city."
      },
      {
        "text": "Turn it down",
        "effects": [ { "type": "happiness", "amount": -4 }, { "type": "relation", "who": "partner", "to": "player", "dim": "closeness", "amount": 8 } ],
        "result": "You stay. Sometimes you wonder what could have been."
      }
    ]
  },
  {
    "id": "adult_sibling_loan", "oncePerTarget": true, "title": "A favour",
    "text": "{t.role}, {t.name}, calls. The business is going under. \"I need to borrow {amount}. Just for a year. Please.\"",
    "conditions": { "minAge": 22 },
    "target": { "role": "sibling", "conditions": { "minAge": 22, "maxMoney": 100000 } },
    "vars": { "amount": { "base": 60000, "incomeFactor": 0.2, "randomMin": 0.8, "randomMax": 1.5 } },
    "cooldown": 8,
    "choices": [
      {
        "text": "Lend {t.him} {amount}",
        "requires": { "minMoney": 60000 },
        "effects": [
          { "type": "transfer", "to": "target", "var": "amount" },
          { "type": "memory", "who": "target", "to": "player", "kind": "helped_money", "text": "{name} lent me money when the business was failing", "impact": 30 }
        ],
        "result": "{t.name} is almost crying with relief. Whether you'll ever see the money again is another question."
      },
      {
        "text": "Lend half",
        "requires": { "minMoney": 30000 },
        "effects": [
          { "type": "transfer", "to": "target", "var": "amount", "amount": 0.5 },
          { "type": "memory", "who": "target", "to": "player", "kind": "half_help", "text": "{name} only lent me half of what I needed", "impact": -5 }
        ],
        "result": "\"Thanks... I guess,\" says {t.name}."
      },
      {
        "text": "Say no",
        "hint": "{t.name} will remember this.",
        "effects": [
          { "type": "memory", "who": "target", "to": "player", "kind": "refused_loan", "text": "{name} refused to lend me money when I needed it most", "impact": -40 },
          { "type": "relation", "who": "target", "to": "player", "dim": "envy", "amount": 15 }
        ],
        "result": "The line goes silent. Then {t.name} hangs up."
      }
    ]
  },
  {
    "id": "adult_parent_sick", "oncePerTarget": true, "title": "A call from the hospital",
    "text": "{t.role} has fallen ill and can't manage alone. Someone needs to help.",
    "conditions": { "minAge": 25 },
    "target": { "role": "parent", "conditions": { "minAge": 60 } }, "cooldown": 6,
    "choices": [
      {
        "text": "Take care of {t.him} yourself",
        "effects": [
          { "type": "happiness", "amount": -6 },
          { "type": "money", "amount": -20000 },
          { "type": "relation", "who": "player", "to": "target", "dim": "closeness", "amount": 15, "mutual": true },
          { "type": "memory", "who": "target", "to": "player", "kind": "cared_for", "text": "{name} took care of me when I was ill", "impact": 35 }
        ],
        "result": "It's exhausting, but you get time together that you'll never regret."
      },
      {
        "text": "Pay for home care",
        "requires": { "minMoney": 60000 },
        "effects": [
          { "type": "money", "amount": -60000 },
          { "type": "memory", "who": "target", "to": "player", "kind": "paid_care", "text": "{name} paid for my care", "impact": 10 }
        ],
        "result": "Professionals take over. {t.name} is grateful, if a little lonely."
      },
      {
        "text": "Let your siblings handle it",
        "requires": { "hasRole": [ "sibling" ] },
        "effects": [ { "type": "memory", "who": "target", "to": "player", "kind": "abandoned_sick", "text": "{name} never came when I was ill", "impact": -30 } ],
        "result": "You have enough on your plate. Or so you tell yourself."
      }
    ]
  },
  {
    "id": "adult_friend_restaurant", "title": "The restaurant",
    "text": "{t.name} wants you to go in as a partner in a restaurant. \"All I need is {amount}. It can't fail!\"",
    "conditions": { "minAge": 25, "minMoney": 50000 },
    "target": { "role": "friend", "conditions": { "minAge": 22 } },
    "vars": { "amount": { "base": 100000, "randomMin": 0.8, "randomMax": 1.4 } },
    "cooldown": 10,
    "choices": [
      {
        "text": "Invest {amount}",
        "chance": 0.4, "chanceTraits": { "ambitious": 0.1 },
        "effects": [ { "type": "money", "var": "amount", "amount": -1 } ],
        "success": {
          "text": "The restaurant is a hit! Your share pays back several times over.",
          "effects": [ { "type": "money", "var": "amount", "amount": 2.5 }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 15, "mutual": true } ]
        },
        "failure": {
          "text": "The restaurant closes after eight months. The money is gone – and things are awkward with {t.name}.",
          "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "bitterness", "amount": 15 } ]
        }
      },
      {
        "text": "Say no politely",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": -5 } ],
        "result": "{t.name} shrugs. \"Your loss.\""
      }
    ]
  },
  {
    "id": "adult_temptation", "title": "Temptation",
    "text": "{t.name}, a new colleague, is flirting with you openly. The chemistry is impossible to ignore.",
    "conditions": { "minAge": 22, "maxAge": 60, "hasPartner": true },
    "target": { "role": "new_person", "sex": "attracted", "ageOffsetMin": -8, "ageOffsetMax": 4 },
    "cooldown": 6,
    "choices": [
      {
        "text": "Start an affair",
        "hint": "Secrets have a way of coming out.",
        "effects": [ { "type": "start_affair", "to": "target" }, { "type": "happiness", "amount": 8 } ],
        "result": "It begins with a drink after work. It doesn't end there."
      },
      {
        "text": "Keep it professional",
        "effects": [ { "type": "trait_add", "trait": "loyal", "chance": 0.15 } ],
        "result": "You go home to {p.name}. It's the right choice, you think."
      },
      {
        "text": "Tell {p.name} about it",
        "effects": [ { "type": "relation", "who": "partner", "to": "player", "dim": "trust", "amount": 10 } ],
        "result": "{p.name} laughs a little nervously, but appreciates your honesty."
      }
    ]
  },
  {
    "id": "adult_burnout", "title": "Running on empty",
    "text": "You've been working too much for too long. You wake up tired and go to bed exhausted.",
    "conditions": { "minAge": 28, "maxAge": 64, "hasJob": true }, "cooldown": 8,
    "choices": [
      {
        "text": "Take sick leave",
        "effects": [ { "type": "health", "amount": 8 }, { "type": "happiness", "amount": 6 } ],
        "result": "A few months of rest. The world keeps turning without you."

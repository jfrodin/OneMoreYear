      {
        "text": "Grit your teeth",
        "chance": 0.35, "chanceTraits": { "ambitious": 0.15, "lazy": -0.2 },
        "effects": [ { "type": "health", "amount": -10 } ],
        "success": { "text": "It pays off. Your boss notices your effort.", "effects": [ { "type": "promote" } ] },
        "failure": { "text": "Your body says stop. You collapse at the office.", "effects": [ { "type": "health", "amount": -8 } ] }
      }
    ]
  },
  {
    "id": "adult_meet_someone", "title": "A spark",
    "text": "At a friend's party you end up talking to {t.name} all evening. Something clicks.",
    "conditions": { "minAge": 18, "maxAge": 70, "hasPartner": false },
    "target": { "role": "new_person", "sex": "attracted", "ageOffsetMin": -5, "ageOffsetMax": 5 },

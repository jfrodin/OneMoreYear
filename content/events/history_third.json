  {
    "id": "hist_columbine", "countries": [ "usa" ], "content": [ "violence" ], "trigger": "history", "title": "A school in Colorado",
    "text": "Two students have opened fire at their high school in Colorado. The pictures of children running out with their hands up are on every channel.",
    "conditions": { "minAge": 10, "minYear": 1999, "maxYear": 1999 }, "weight": 3, "cooldown": 0,
    "choices": [
      { "text": "Hold your family close", "effects": [ { "type": "happiness", "amount": -4 } ], "result": "You hug your people for longer than usual that night. The school sends a letter about new safety drills. You read it twice." },

  {
    "id": "hist_iraq_2003", "countries": [ "usa" ], "trigger": "history", "title": "Shock and awe",
    "text": "The war in Iraq has started. On television, explosions over Baghdad at night, and reporters riding along with the troops.",
    "conditions": { "minAge": 14, "minYear": 2003, "maxYear": 2003 }, "weight": 3, "cooldown": 0,

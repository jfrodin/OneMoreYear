      { "text": "March against it", "requires": { "minAge": 16 }, "effects": [ { "type": "trait_add", "trait": "brave", "chance": 0.03 } ], "result": "A Saturday in the cold with a cardboard sign. A neighbour does not speak to you for a year." },
      { "text": "Fly the flag", "effects": [ { "type": "trait_add", "trait": "loyal", "chance": 0.03 } ], "result": "A flag on the porch and a yellow ribbon round the tree. Someone on your street has a son over there." },

  {
    "id": "mt_bar_fight_witness", "content": [ "violence" ], "title": "Outside the bar",
    "text": "Closing time. Two men are shouting outside the bar, and then one of them is on the ground and the other one is still kicking.",
    "conditions": { "minAge": 18, "maxAge": 50 }, "cooldown": 10, "weight": 0.6,
    "choices": [
      { "text": "Step in", "chance": 0.55, "chanceAttributes": { "fitness": 0.006 }, "chanceTraits": { "brave": 0.1 },
        "success": { "text": "You shout, you get between them, and it stops. The man on the ground is bleeding but conscious. You give a statement at three in the morning, shaking.", "effects": [ { "type": "trait_add", "trait": "brave", "chance": 0.08 }, { "type": "happiness", "amount": 2 } ] },
        "failure": { "text": "A fist you did not see coming. A broken nose, a night in the emergency room, and the other man is gone.", "effects": [ { "type": "health", "amount": -8 }, { "type": "money", "amount": -2000 } ] } },
      { "text": "Call the police", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "They come in eleven minutes. Eleven very long minutes. You hear later that he lived." },
      { "text": "Walk away fast", "effects": [ { "type": "happiness", "amount": -4 } ], "result": "You walk away. You read about it in the paper on Monday. You read it several times." }
    ]
  },
  {

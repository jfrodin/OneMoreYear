        "success": { "text": "\"I wondered when you would call.\" A spare room, a long talk, and the first clear look at your own life in years.", "effects": [ { "type": "breakup" }, { "type": "happiness", "amount": 4 }, { "type": "memory", "kind": "got_out", "to": "target", "text": "The day I left {t.name}", "impact": 15 } ] },

    ]
  },
  {
    "id": "mt_controlling_partner", "content": [ "violence" ], "title": "Who were you talking to?",
    "text": "{p.name} goes through your things now. Asks where you were, and with whom, and why it took so long. Your friends have stopped calling, because {p.he} does not like them.",

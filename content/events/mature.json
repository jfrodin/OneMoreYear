  {
    "id": "mt_old_flame_message", "content": [ "infidelity" ], "title": "A message",
    "text": "A friend request from someone you loved at nineteen. Then a message: \"I think about you sometimes. Do you ever think about me?\"",
    "conditions": { "minAge": 30, "maxAge": 65, "hasPartner": true, "minYear": 2007 }, "cooldown": 15, "weight": 0.8,

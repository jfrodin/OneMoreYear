    "choices": [
      { "text": "Write back", "effects": [ { "type": "happiness", "amount": 4 }, { "type": "start_affair", "to": "target", "chance": 0.4 } ], "result": "One message becomes forty. You delete them every night. You tell yourself it is only words." },
      { "text": "Delete it and tell {p.name}", "effects": [ { "type": "relation", "who": "partner", "to": "player", "dim": "respect", "amount": 5 } ], "result": "{p.name} laughs, then goes quiet, then holds your hand a little tighter on the walk that evening." },
      { "text": "Delete it and never mention it", "effects": [], "result": "Gone. You think about it more than you would like to admit, for about a month." }
    ]
  },
  {

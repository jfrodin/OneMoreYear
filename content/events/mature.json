      { "text": "Push through until the holidays", "effects": [ { "type": "ailment_add", "kind": "burnout", "chance": 0.5 }, { "type": "health", "amount": -3 } ], "result": "The holidays come. You get ill on the first day off, as if your body was waiting for permission." }
    ]

    "target": { "role": "friend", "conditions": { "addicted": true } },
    "choices": [
      { "text": "Keep showing up for {t.him}", "chance": 0.3, "chanceTraits": { "loyal": 0.15 },
        "success": { "text": "Months of it. Then one night {t.he} says, \"I need help,\" and you drive {t.him} there.", "effects": [ { "type": "recover", "who": "target" }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 15, "mutual": true } ] },
        "failure": { "text": "You show up. {t.He} does not. It wears you down slowly, the way water wears stone.", "effects": [ { "type": "happiness", "amount": -4 } ] } },
      { "text": "Step away", "effects": [ { "type": "friend_remove", "to": "target" }, { "type": "happiness", "amount": -2 } ], "result": "You have to, for your own sake. You still ask mutual friends about {t.him} sometimes, late at night." }
    ]
  },
  {
    "id": "mt_panic_attack", "content": [ "mental_health" ], "title": "In the supermarket",
    "text": "In the queue at the supermarket your heart starts racing, your hands go numb and you are certain, absolutely certain, that you are dying.",
    "conditions": { "minAge": 16, "notAilments": [ "anxiety" ] }, "cooldown": 15, "weight": 0.6,
    "choices": [
      { "text": "Go to the emergency room", "effects": [ { "type": "money", "amount": -1000 }, { "type": "ailment_add", "kind": "anxiety", "chance": 0.5 } ], "result": "Your heart is fine, they say. It was panic. You feel foolish and frightened at the same time, which is a new combination." },
      { "text": "Leave the trolley and walk out", "effects": [ { "type": "ailment_add", "kind": "anxiety", "chance": 0.7 }, { "type": "happiness", "amount": -4 } ], "result": "You sit in the car until it passes. You do not go back to that supermarket for a year." }
    ]
  },
  {
    "id": "mt_therapy_first", "content": [ "mental_health" ], "title": "The first session",
    "text": "A waiting room with a box of tissues on every surface. Your name is called. You have not said any of this out loud to anyone.",
    "conditions": { "minAge": 16, "ailmentsAny": [ "depression", "anxiety", "trauma", "burnout" ], "minYear": 1965 }, "cooldown": 8,
    "choices": [
      { "text": "Say all of it", "effects": [ { "type": "ailment_treat" }, { "type": "money", "amount": -6000 }, { "type": "happiness", "amount": 3 } ], "result": "Fifty minutes go very quickly. You cry, which you did not plan. You book the next one before you leave." },
      { "text": "Talk about the weather", "effects": [ { "type": "money", "amount": -1200 } ], "result": "You are very charming. The therapist is very patient. You do not go back. Maybe next year." }
    ]
  },
  {
    "id": "mt_dark_winter", "content": [ "mental_health" ], "countries": [ "sweden" ], "title": "November",
    "text": "It is dark when you leave in the morning and dark when you come home. It has been grey for six weeks. Everything is heavy.",
    "conditions": { "minAge": 16 }, "cooldown": 6,
    "choices": [
      { "text": "Buy a daylight lamp", "requires": { "minYear": 1985 }, "effects": [ { "type": "money", "amount": -1500 }, { "type": "happiness", "amount": 3 } ], "result": "Twenty minutes every morning in front of a very bright box. Ridiculous. It works, a bit." },
      { "text": "Go for a walk at lunch, every day", "effects": [ { "type": "attribute", "kind": "fitness", "amount": 1 }, { "type": "happiness", "amount": 2 } ], "result": "Half an hour of grey light is still light. You count the days to the solstice, and then the minutes." },
      { "text": "Stay in", "effects": [ { "type": "happiness", "amount": -3 }, { "type": "ailment_add", "kind": "depression", "chance": 0.08 } ], "result": "The sofa, the blanket, the television. It is easier. It is also how it starts, sometimes." }
    ]
  },
  {
    "id": "mt_new_mother_low", "content": [ "mental_health" ], "title": "Not what they said",
    "text": "Everyone said it would be the happiest time of your life. You have a beautiful baby, and you feel nothing at all, except tired and afraid.",
    "conditions": { "minAge": 18, "sex": "female" }, "cooldown": 30, "weight": 2,
    "target": { "role": "child", "conditions": { "maxAge": 0 } },
    "choices": [
      { "text": "Tell the nurse at the check up", "chance": 0.75,
        "success": { "text": "The nurse has heard it many times. It has a name. There is help. Months later, one morning, you look at {t.name} and feel everything at once.", "effects": [ { "type": "ailment_add", "kind": "depression", "chance": 0.4 }, { "type": "ailment_treat" }, { "type": "happiness", "amount": 2 } ] },
        "failure": { "text": "\"All new mothers are tired.\" You nod and go home.", "effects": [ { "type": "ailment_add", "kind": "depression", "chance": 0.6 }, { "type": "happiness", "amount": -5 } ] } },
      { "text": "Pretend everything is fine", "effects": [ { "type": "ailment_add", "kind": "depression", "chance": 0.6 }, { "type": "happiness", "amount": -6 } ], "result": "You smile in the photographs. You are very good at it. Nobody asks." }
    ]
  },
  {
    "id": "mt_burnout_warning", "content": [ "mental_health" ], "title": "The word",
    "text": "You stood in the shower this morning and forgot what shampoo was for. Yesterday you cried in the car park. A colleague uses a word you do not want to hear.",

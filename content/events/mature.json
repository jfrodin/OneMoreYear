[
  {
    "id": "mt_partner_drinking", "content": [ "addiction" ], "title": "The bottles",
    "text": "You find empty bottles behind the boxes in the cellar. A lot of them. {p.name} said {p.he} had stopped.",
    "conditions": { "minAge": 20, "hasPartner": true }, "cooldown": 4, "weight": 2,
    "target": { "role": "partner", "conditions": { "addicted": true } },
    "choices": [
      { "text": "Confront {t.him}, gently", "chance": 0.35, "chanceTraits": { "kind": 0.1, "charming": 0.1 },
        "success": { "text": "A long night, a lot of crying, and in the morning {t.he} calls a clinic. It is the start of something, not the end.", "effects": [ { "type": "recover", "who": "target" }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 8 } ] },
        "failure": { "text": "Denial, then anger, then a door slammed. The bottles move to a new hiding place.", "effects": [ { "type": "happiness", "amount": -5 }, { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 5 } ] } },
      { "text": "Pour them all out", "effects": [ { "type": "happiness", "amount": -3 } ], "result": "It feels like doing something. It is not. New ones appear within the week." },
      { "text": "Say nothing", "effects": [ { "type": "happiness", "amount": -4 }, { "type": "trait_add", "trait": "conflict_averse", "chance": 0.05 } ], "result": "You put the boxes back exactly as they were, and you start counting, every week, without wanting to." }
    ]
  },
  {
    "id": "mt_parent_drinking_child", "content": [ "addiction" ], "title": "Friday nights",
    "text": "On Friday nights {t.name} changes. Louder, then sad, then asleep on the sofa. You have learned to make your own dinner.",
    "conditions": { "minAge": 8, "maxAge": 17, "livesWithParents": true }, "cooldown": 5, "weight": 2,
    "target": { "role": "parent", "conditions": { "addicted": true } },
    "choices": [
      { "text": "Tell a teacher", "chance": 0.6,
        "success": { "text": "The teacher listens, properly. A counsellor, a phone call home, a lot of shame, and slowly, help.", "effects": [ { "type": "happiness", "amount": 2 }, { "type": "trait_add", "trait": "brave", "chance": 0.05 } ] },
        "failure": { "text": "The teacher says it is probably not as bad as you think. You stop telling people things.", "effects": [ { "type": "happiness", "amount": -4 }, { "type": "trait_add", "trait": "introvert", "chance": 0.05 } ] } },
      { "text": "Cover for {t.him}", "effects": [ { "type": "happiness", "amount": -3 }, { "type": "trait_add", "trait": "dishonest", "chance": 0.04 }, { "type": "trait_add", "trait": "resilient", "chance": 0.04 } ], "result": "You become very good at excuses. Sick again. Working late. You are a child and you sound like an adult." },
      { "text": "Stay at a friend's on Fridays", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "Their house is calm and smells of dinner. Their parents ask no questions. You will remember that kindness all your life." }
    ]
  },
  {
    "id": "mt_sibling_gambling", "content": [ "addiction" ], "title": "A loan",
    "text": "{t.name} needs money, quickly. {t.He} will not say what for, but you have seen the [[2008: betting slips in {t.his} jacket || betting apps on {t.his} phone]].",
    "conditions": { "minAge": 20, "minMoney": 10000 }, "cooldown": 6, "weight": 2,
    "target": { "role": "sibling", "conditions": { "addicted": true, "minAge": 18 } },
    "choices": [
      { "text": "Lend it", "effects": [ { "type": "transfer", "to": "target", "amount": 20000 }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 4 } ], "result": "{t.He} promises to pay it back by summer. You both know {t.he} will not." },
      { "text": "Offer to pay for help instead", "chance": 0.35,
        "success": { "text": "{t.He} is furious, then quiet, then says yes. A group on Tuesday evenings. It holds.", "effects": [ { "type": "money", "amount": -8000 }, { "type": "recover", "who": "target" } ] },
        "failure": { "text": "\"I don't have a problem. I have a cash flow issue.\" {t.He} hangs up.", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": -6 } ] } },
      { "text": "Say no", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 6 }, { "type": "happiness", "amount": -2 } ], "result": "{t.He} finds the money somewhere else. You do not want to know where." }
    ]
  },
  {
    "id": "mt_adult_child_using", "content": [ "addiction" ], "title": "Your child",
    "text": "{t.name} has lost weight, lost a job, and keeps asking to borrow money for things that do not exist. You know. You have known for a while.",
    "conditions": { "minAge": 38 }, "cooldown": 5, "weight": 2,
    "target": { "role": "child", "conditions": { "addicted": true, "minAge": 17 } },
    "choices": [
      { "text": "Pay for rehab", "requires": { "minMoney": 40000 }, "chance": 0.5, "chanceTraits": { "devoted_parent": 0.1 },
        "success": { "text": "Ninety days. A thinner, clearer {t.name} on the other side, who hugs you for a long time at the gate.", "effects": [ { "type": "money", "amount": -40000 }, { "type": "recover", "who": "target" }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 10, "mutual": true } ] },
        "failure": { "text": "{t.He} leaves after a week. The money is gone. You would pay it again tomorrow.", "effects": [ { "type": "money", "amount": -40000 }, { "type": "happiness", "amount": -8 } ] } },
      { "text": "Stop giving money", "effects": [ { "type": "happiness", "amount": -6 }, { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 8 } ], "result": "Tough love, the counsellor calls it. It does not feel like love. It feels like closing a door on your child." },
      { "text": "Keep giving, just in case", "effects": [ { "type": "transfer", "to": "target", "amount": 15000 }, { "type": "happiness", "amount": -4 } ], "result": "At least you know where {t.he} is when {t.he} comes for money. That is what you tell yourself." }
    ]
  },
  {
    "id": "mt_friend_addiction", "content": [ "addiction" ], "title": "Not the same",
    "text": "{t.name} has stopped turning up. When {t.he} does, {t.he} is somewhere else behind {t.his} eyes.",

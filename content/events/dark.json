// The dark side, driven by traits. See docs/design-decisions.md: abuse is shown through its
// consequences and never described in detail. The player is never asked to abuse anyone.
[
  {
    "id": "addiction_begins", "content": [ "addiction" ], "trigger": "situation",
    "title": "Just one more",
    "text": "It started as a way to cope. Now you think about it when you wake up, and it's the last thing on your mind at night.",
    "choices": [
      {
        "text": "Get help now, before it gets worse",
        "chance": 0.5, "chanceTraits": { "resilient": 0.25, "addictive": -0.2 },
        "success": { "text": "It's hard, but you stop in time.", "effects": [ { "type": "recover" } ] },
        "failure": { "text": "You try. You slip. It's still there.", "effects": [ { "type": "happiness", "amount": -6 } ] }
      },
      {
        "text": "It's under control",
        "effects": [ { "type": "happiness", "amount": 5 } ],
        "result": "Everyone needs something to take the edge off. Right?"
      }
    ]
  },
  {
    "id": "addiction_crossroads", "content": [ "addiction" ], "title": "Rock bottom",
    "text": "The money is disappearing, your body hurts and the people around you have stopped believing your excuses.",
    "conditions": { "flags": [ "addicted" ] }, "weight": 3, "cooldown": 2,
    "choices": [
      {
        "text": "Check into rehab",
        "hint": "Costs money and time – and it doesn't always work the first time.",
        "effects": [ { "type": "money", "amount": -40000 } ],
        "chance": 0.55, "chanceTraits": { "resilient": 0.2, "addictive": -0.15 },
        "success": { "text": "Eight weeks later you walk out clean. The world looks sharper.", "effects": [ { "type": "recover" }, { "type": "health", "amount": 8 } ] },
        "failure": { "text": "You leave after two weeks. You're not ready.", "effects": [ { "type": "happiness", "amount": -8 } ] }
      },
      {
        "text": "Ask your family for help",
        "chance": 0.4, "chanceTraits": { "social": 0.1, "resilient": 0.15 },
        "success": { "text": "They don't give up on you. Slowly, you climb out.", "effects": [ { "type": "recover" } ] },
        "failure": { "text": "They've heard the promises before.", "effects": [ { "type": "happiness", "amount": -6 } ] }
      },
      {
        "text": "Keep going",
        "effects": [ { "type": "health", "amount": -6 }, { "type": "happiness", "amount": 4 } ],
        "result": "One more year like this."
      }
    ]
  },
  {
    "id": "violence_by_partner", "content": [ "violence" ], "trigger": "situation",
    "title": "The bruise",
    "text": "It happened again. {t.name} hit you – and afterwards {t.he} cried and said it would never happen again.",
    "choices": [
      {
        "text": "Leave {t.him}",
        "chance": 0.7, "chanceTraits": { "brave": 0.15, "resilient": 0.1, "conflict_averse": -0.2 },
        "success": { "text": "You take what you can carry and go. It's the bravest thing you've ever done.", "effects": [ { "type": "breakup" }, { "type": "trait_add", "trait": "resilient", "chance": 0.3 } ] },
        "failure": { "text": "You pack a bag, then unpack it again. Not yet.", "effects": [ { "type": "happiness", "amount": -10 } ] }
      },
      {
        "text": "Report {t.him} to the police",
        "effects": [
          { "type": "log", "text": "{name} reported {t.name} to the police for assault.", "importance": 3 },
          { "type": "memory", "who": "target", "to": "player", "kind": "reported", "text": "{name} reported me to the police", "impact": -40 },
          { "type": "breakup" }
        ],
        "result": "The police take your statement. {t.name} is not allowed to come near you."
      },
      {
        "text": "Forgive {t.him}",
        "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "trust", "amount": -15 }, { "type": "happiness", "amount": -8 } ],
        "result": "You want to believe {t.him}. You really do."
      }
    ]
  },
  {
    "id": "violence_by_parent", "content": [ "violence" ], "trigger": "situation",
    "title": "Behind closed doors",
    "text": "{T.role} hit you again tonight. You've learned to read the signs, but it doesn't help.",
    "choices": [
      {
        "text": "Tell a teacher",
        "chance": 0.5, "chanceTraits": { "brave": 0.15, "conflict_averse": -0.15 },
        "success": {
          "text": "Your teacher believes you. Social services come to the house. Things change.",
          "effects": [
            { "type": "log", "text": "Social services stepped in after {name} told a teacher about {t.name}.", "importance": 3 },
            { "type": "relation", "who": "target", "to": "player", "dim": "fear", "amount": 20 }
          ]
        },
        "failure": { "text": "The teacher calls home. {t.name} is furious.", "effects": [ { "type": "happiness", "amount": -10 } ] }
      },
      {
        "text": "Keep it to yourself",
        "effects": [ { "type": "trait_add", "trait": "conflict_averse", "chance": 0.3 }, { "type": "happiness", "amount": -6 } ],
        "result": "You go to school with long sleeves."
      }
    ]
  },
  {
    "id": "losing_temper", "content": [ "violence" ], "title": "The rage",
    "text": "{t.name} says the wrong thing at the wrong moment. The anger comes from nowhere and fills the whole room.",
    "conditions": { "minAge": 18, "hasPartner": true, "traitsAny": [ "hot_tempered", "cruel" ] },
    "target": { "role": "partner" }, "cooldown": 3,
    "choices": [
      {
        "text": "Walk out and cool down",
        "chance": 0.6, "chanceTraits": { "hot_tempered": -0.2, "resilient": 0.1 },
        "success": { "text": "You walk around the block until your hands stop shaking.", "effects": [] },
        "failure": { "text": "You don't make it to the door.", "effects": [ { "type": "violence", "to": "target" } ] }
      },
      {
        "text": "Smash something",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "fear", "amount": 20 } ],
        "result": "The plate shatters against the wall. {t.name} looks at you like a stranger."
      },
      {
        "text": "Lash out",
        "hint": "There is no taking this back.",
        "effects": [ { "type": "violence", "to": "target" } ],
        "result": "Afterwards the house is very quiet."
      }
    ]
  },
  {
    "id": "jealous_partner", "title": "Who were you texting?",
    "text": "{t.name} has been through your phone again. \"Who is this? Why are you always talking to them?\"",
    "conditions": { "minAge": 16, "hasPartner": true },
    "target": { "role": "partner", "conditions": { "traitsAny": [ "jealous" ] } }, "cooldown": 3,
    "choices": [
      {
        "text": "Reassure {t.him}",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "trust", "amount": 10 } ],
        "result": "It takes all evening, but {t.he} calms down."
      },
      {
        "text": "Promise to see less of your friends",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": -10 }, { "type": "happiness", "amount": -6 } ],
        "result": "{t.name} is happy. Your friends stop calling."
      },
      {
        "text": "\"You're not my prison guard\"",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 15 } ],
        "result": "A door slams. It's not the last time."
      }
    ]
  },
  {
    "id": "abuse_child", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "A secret",
    "text": "After the weekend at {t.name}'s you feel sick and scared, and you don't know why. {t.He} said it was your special secret – and that nobody would believe you anyway.",
    "choices": [
      {
        "text": "Tell someone you trust",
        "chance": 0.45, "chanceTraits": { "brave": 0.15, "social": 0.05 },
        "success": {
          "text": "They believe you. Everything falls apart – and you are safe.",
          "effects": [ { "type": "reveal_abuse" } ]
        },
        "failure": {
          "text": "\"Don't say things like that about {t.name}.\" You never try again.",
          "effects": [ { "type": "happiness", "amount": -10 }, { "type": "trait_add", "trait": "paranoid", "chance": 0.3 } ]
        }
      },
      {
        "text": "Keep the secret",
        "effects": [ { "type": "happiness", "amount": -6 } ],
        "result": "You carry it alone."
      }
    ]
  },
  {
    "id": "carry_secret", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "What you carry",
    "text": "You have carried it since you were a child – what {t.name} did. Nobody in the family knows.",
    "choices": [
      {
        "text": "Tell the family",
        "hint": "Nothing will be the same.",
        "effects": [ { "type": "reveal_abuse" } ],
        "result": "You say it out loud for the first time. The room goes silent."
      },
      {
        "text": "Confront {t.name}",
        "effects": [
          { "type": "relation", "who": "target", "to": "player", "dim": "fear", "amount": 40 },
          { "type": "memory", "kind": "confronted_abuser", "to": "target", "text": "I told {t.name} I remember everything", "impact": 10 }
        ],
        "result": "{t.name} goes pale and says nothing. For once, you are the one who isn't afraid."
      },
      {
        "text": "Keep carrying it",
        "effects": [ { "type": "happiness", "amount": -8 } ],
        "result": "Maybe one day."
      }
    ]
  },

  // Scenario "The family secret": the grandfather is also the biological father of his grandchild,
  // born from abuse of his daughter that began when she was a child. It happened long before the player
  // takes over and is never described. Played from three sides – only the secret, the guilt and the
  // reckoning. The player never commits abuse (docs/design-decisions.md).
  {
    "id": "origin_start_grandfather", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "Roots",
    "text": "At {t.name}'s birthday dinner {t.he} tells everyone about the DNA kit {t.he} has ordered – \"to find out where we really come from\". Everyone laughs. Everyone except {o.name}, {t.his} mother, who puts down her fork and looks straight at you. You are the only two people alive who know who {t.name}'s father really is.",
    "choices": [
      {
        "text": "Give {o.name} money to keep the past buried",
        "effects": [
          { "type": "transfer", "to": "other", "amount": 200000 },
          { "type": "relation", "who": "other", "to": "player", "dim": "bitterness", "amount": 25 },
          { "type": "memory", "who": "other", "to": "player", "kind": "silence_bought", "text": "{name} tried to pay for my silence", "impact": -30 }
        ],
        "result": "She takes the envelope without a word. You can't tell whether that means yes."
      },
      {
        "text": "Talk {t.name} out of the test",
        "chance": 0.5, "chanceTraits": { "charming": 0.15, "manipulative": 0.15 },
        "success": { "text": "\"You're right, Grandpa, it's just a silly trend.\" The kit ends up in a drawer. For now." },
        "failure": { "text": "{t.He} gives you a strange look. Why would Grandpa care so much?",
          "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "trust", "amount": -20 } ] }
      },
      {
        "text": "Threaten {o.name}",
        "effects": [
          { "type": "relation", "who": "other", "to": "player", "dim": "fear", "amount": 30 },
          { "type": "relation", "who": "other", "to": "player", "dim": "bitterness", "amount": 30 }
        ],
        "result": "You remind her, quietly, who the family has always believed. She has heard it before."
      },
      {
        "text": "Tell them the truth",
        "hint": "There is no taking it back.",
        "effects": [ { "type": "reveal_origin", "kind": "confess" } ],
        "result": "You say it. For a long moment nobody moves. Then {t.name} stands up and walks out."
      }
    ]
  },
  {
    "id": "origin_start_mother", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "The DNA kit",
    "text": "{t.name} shows you the DNA kit {t.he} has ordered. \"Don't you want to know where we come from, Mum?\" {t.He} has no idea that the man {t.he} calls Dad is not {t.his} father. {t.His} father is {o.name} – your own father. For {t.age} years you have carried it alone.",
    "choices": [
      {
        "text": "Ask {t.him} not to send it",
        "chance": 0.5,
        "success": { "text": "{t.He} shrugs and puts it in a drawer. For now." },
        "failure": { "text": "\"Why are you being so weird about it?\" {t.He} sends it the next day.",
          "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "trust", "amount": -15 } ] }
      },
      {
        "text": "Go to {o.name}",
        "effects": [
          { "type": "relation", "who": "player", "to": "other", "dim": "bitterness", "amount": 20 },
          { "type": "happiness", "amount": -10 }
        ],
        "result": "\"Nobody would believe you,\" {o.name} says, the way he always has. But his hands are shaking."
      },
      {
        "text": "Tell {t.name} the truth yourself",
        "hint": "Better from you than from a letter.",
        "effects": [ { "type": "reveal_origin" } ],
        "result": "You sit {t.him} down in the kitchen and tell {t.him} everything. It takes an hour. It has taken {t.age} years."
      },
      {
        "text": "Say nothing",
        "effects": [ { "type": "happiness", "amount": -8 } ],
        "result": "You smile and say it sounds fun. You don't sleep that night."
      }
    ]
  },
  {
    "id": "origin_start_child", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "Roots",
    "text": "You've ordered a DNA kit to learn more about the family. When you tell Mum, {t.name} goes white and leaves the room. Grandpa {o.name} laughs a little too loudly and says it's a waste of money.",
    "choices": [
      {
        "text": "Send the test",
        "chance": 0.7,
        "success": { "text": "Six weeks later the results arrive.", "effects": [ { "type": "reveal_origin" } ] },
        "failure": { "text": "The sample gets lost in the mail. You don't order another one – not yet." }
      },
      {
        "text": "Ask Mum what's wrong",
        "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "closeness", "amount": 5, "mutual": true } ],
        "result": "She holds you for a long time and says nothing. Over her shoulder you can see Grandpa watching."
      },
      {
        "text": "Throw the kit away",
        "result": "Some things are better not knowing. You tell yourself that, anyway."
      }
    ]
  },
  {
    "id": "origin_revealed_child", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "The results",
    "text": "At first the DNA match makes no sense. Then it does. Your biological father is {t.name} – your grandfather. {o.name}, your mother, was only a child when it started. She has carried it your whole life.",
    "choices": [
      {
        "text": "Go to Mum",
        "effects": [
          { "type": "relation", "who": "player", "to": "other", "dim": "closeness", "amount": 20, "mutual": true },
          { "type": "memory", "kind": "origin_mother", "to": "other", "text": "Mum and I finally talked about it", "impact": 15 }
        ],
        "result": "She has waited {age} years for this conversation. You both cry until it gets light outside."
      },
      {
        "text": "Report {t.name} to the police",
        "chance": 0.7,
        "success": { "text": "The DNA is all the evidence they need.",
          "effects": [ { "type": "convicted", "who": "target", "kind": "child_abuse", "to": "other" } ] },
        "failure": { "text": "The prosecutor says it was too long ago. {t.name} walks free. The family doesn't." }
      },
      {
        "text": "Confront {t.name}",
        "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "fear", "amount": 30 } ],
        "result": "He says it was \"a different time\". You leave before you do something you'll regret."
      },
      {
        "text": "Cut them all off",
        "effects": [ { "type": "happiness", "amount": -15 }, { "type": "move_city" } ],
        "result": "You move away and change your number. You don't know who you are anymore – but you know who you're not."
      }
    ]
  },
  {
    "id": "origin_revealed_mother", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "It's out",
    "text": "{t.name} knows. Soon the whole family knows. For {t.age} years it was yours alone to carry. Now everyone is looking at you – and at {o.name}.",
    "choices": [
      {
        "text": "Hold on to {t.name}",
        "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "closeness", "amount": 20, "mutual": true } ],
        "result": "\"None of it was your fault,\" {t.he} says. You have waited your whole life to hear it."
      },
      {
        "text": "Report {o.name} to the police",
        "chance": 0.7,
        "success": { "text": "This time, somebody believes you.",
          "effects": [ { "type": "convicted", "who": "other", "kind": "child_abuse", "to": "player" } ] },
        "failure": { "text": "The prosecutor says it was too long ago. {o.name} walks free." }
      },
      {
        "text": "Leave town",
        "effects": [ { "type": "move_city" }, { "type": "happiness", "amount": -5 } ],
        "result": "You pack one suitcase and leave. For the first time in years you can breathe."
      }
    ]
  },
  {
    "id": "abuse_revealed", "content": [ "sexual_abuse" ], "trigger": "situation",
    "title": "Everyone knows",
    "text": "The family knows what you did to {t.name}. The phone has stopped ringing. Your own children won't look at you. Then the police call and ask you to come in for questioning.",
    "choices": [
      {
        "text": "Admit everything",
        "effects": [ { "type": "convicted", "kind": "child_abuse", "to": "target" } ],
        "result": "You tell them everything. The trial is short."
      },
      {
        "text": "Deny it",
        "chance": 0.45, "chanceTraits": { "manipulative": 0.15, "charming": 0.1, "dishonest": 0.1 },
        "success": { "text": "So many years later there is no evidence. The case is dropped – but the family knows, and they always will.",
          "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 30 } ] },
        "failure": { "text": "The court believes {t.name}.",
          "effects": [ { "type": "convicted", "kind": "child_abuse", "to": "target" } ] }
      },
      {
        "text": "Move away",
        "hint": "The police can still find you.",
        "chance": 0.6,
        "success": { "text": "You move to a town where nobody knows your name. The past comes with you anyway.",
          "effects": [ { "type": "move_city" }, { "type": "happiness", "amount": -10 } ] },
        "failure": { "text": "They find you before you have unpacked.",
          "effects": [ { "type": "convicted", "kind": "child_abuse", "to": "target" } ] }
      }
    ]
  }
]

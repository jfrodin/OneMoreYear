        "failure": { "text": "It goes wrong fast. A struggle, a cut hand, and an arrest. You think about the child for weeks.", "effects": [ { "type": "health", "amount": -3 }, { "type": "happiness", "amount": -4 }, { "type": "ailment_add", "kind": "trauma", "chance": 0.08 } ] } }

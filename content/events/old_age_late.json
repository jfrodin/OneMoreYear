  {
    "id": "late_hearing_aid", "title": "Pardon?",
    "text": "The grandchildren have started talking louder at dinner, and slower. Someone has left a leaflet about hearing aids on your chair.",
    "conditions": { "minAge": 70 }, "cooldown": 30,
    "choices": [
      { "text": "Get them", "effects": [ { "type": "money", "amount": -6000 }, { "type": "happiness", "amount": 4 } ], "result": "Birds. You had forgotten about birds. And the fridge hums, it turns out, all the time." },
      { "text": "Pretend you heard", "requires": { "traitsAny": [ "vain", "paranoid", "hot_tempered" ] }, "effects": [ { "type": "happiness", "amount": -2 } ], "result": "You nod at the right moments, mostly. Once you agree to something and find out later it was a cruise." },
      { "text": "Ask them to sit closer", "effects": [ { "type": "happiness", "amount": 2 } ], "result": "They do. It is nicer, anyway, with everyone a bit closer." }
    ]
  },
  {

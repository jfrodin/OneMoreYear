      { "text": "A city you have never seen", "hint": "Museums, markets, sore feet.", "requires": { "minMoney": 10000 }, "effects": [ { "type": "money", "amount": -10000 }, { "type": "happiness", "amount": 5 } ], "result": "Twenty thousand steps a day, a meal you still talk about, and a church you cannot pronounce." },
      { "text": "Somewhere very far away", "hint": "Expensive, and once in a lifetime.", "requires": { "minMoney": 60000 }, "effects": [ { "type": "money", "amount": -50000 }, { "type": "happiness", "amount": 10 }, { "type": "memory", "kind": "far_journey", "text": "The journey to the other side of the world", "impact": 18 } ], "result": "Three weeks on the other side of the world. Nothing at home looks quite the same afterwards." },
      { "text": "Camping, cheaply", "hint": "A tent, a lake and a lot of mosquitoes.", "requires": { "minMoney": 2000 }, "effects": [ { "type": "money", "amount": -2000 }, { "type": "happiness", "amount": 3 }, { "type": "attribute", "kind": "fitness", "amount": 1 } ], "result": "It rains for four days out of seven. The other three are perfect." }
    ]
  },
  {

// Things to do with your own time, at every age. Each takes some of the year's time. No dashes.
[
  {
    "id": "own_play_outside", "trigger": "self", "category": "life", "title": "Play outside",
    "conditions": { "minAge": 5, "maxAge": 12 },
    "choices": [
      { "text": "Build a hut in the woods", "hint": "Planks, a tarpaulin and a secret password.", "effects": [ { "type": "happiness", "amount": 4 }, { "type": "attribute", "kind": "fitness", "amount": 1 } ], "result": "It leaks, it leans, and it is the best house you will ever have." },
      { "text": "Football in the street", "hint": "Jumpers for goalposts until it gets dark.", "effects": [ { "type": "attribute", "kind": "fitness", "amount": 2 }, { "type": "happiness", "amount": 3 }, { "type": "trait_add", "trait": "social", "chance": 0.03 } ], "result": "Somebody's mother calls everyone in for dinner, one by one, until there is nobody left to play." },
      { "text": "Climb the big tree", "hint": "Higher than anyone has ever been.", "chance": 0.8, "chanceAttributes": { "fitness": 0.002 },
        "success": { "text": "From the top you can see the whole street and the roof of the school. Nobody believes you got that high.", "effects": [ { "type": "happiness", "amount": 5 }, { "type": "trait_add", "trait": "brave", "chance": 0.04 } ] },
        "failure": { "text": "A branch that was not as strong as it looked. Six weeks in a cast that everyone signs.", "effects": [ { "type": "health", "amount": -6 }, { "type": "happiness", "amount": 1 } ] } }
    ]
  },
  {
    "id": "own_read", "trigger": "self", "category": "life", "title": "Read",
    "conditions": { "minAge": 6, "maxAge": 16 },
    "choices": [
      { "text": "Read under the covers with a torch", "hint": "One more chapter. Then one more.", "effects": [ { "type": "attribute", "kind": "smarts", "amount": 2 }, { "type": "happiness", "amount": 2 } ], "result": "You finish the whole series in a month. Then you start it again." }
    ]
  },
  {
    "id": "own_help_home", "trigger": "self", "category": "life", "title": "Help at home",
    "conditions": { "minAge": 6, "maxAge": 17, "livesWithParents": true },
    "target": { "role": "parent" },
    "choices": [
      { "text": "Do the washing up without being asked", "hint": "Small things are noticed.", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 4 }, { "type": "money", "amount": 200 } ], "result": "{t.name} stands in the kitchen doorway, says nothing, and later there is a little extra pocket money." }
    ]
  },
  {
    "id": "own_screen", "trigger": "self", "category": "life", "title": "[[1995: Television || Screens]]",
    "conditions": { "minAge": 5, "maxAge": 17 },
    "choices": [
      { "text": "[[1995: Watch everything that is on || Watch everything, everywhere]]", "hint": "A whole afternoon gone, happily.", "effects": [ { "type": "happiness", "amount": 3 }, { "type": "grades", "amount": -1 } ], "result": "[[1995: You know every jingle by heart. || You know every video everyone talks about.]] Your homework does not." }
    ]
  },
  {
    "id": "own_hang_out", "trigger": "self", "category": "life", "title": "Hang out",
    "conditions": { "minAge": 12, "maxAge": 19 },
    "choices": [
      { "text": "[[1980: At the youth club || At the shopping centre]]", "hint": "Nothing happens, for hours. That is the point.", "effects": [ { "type": "happiness", "amount": 4 }, { "type": "trait_add", "trait": "social", "chance": 0.04 } ], "result": "Hours of nothing, with the right people. You remember almost none of it, and all of it." },
      { "text": "A party you were not really invited to", "hint": "Older kids, louder music.", "chance": 0.6, "chanceTraits": { "social": 0.15, "charming": 0.1 },
        "success": { "text": "Nobody asks who you are. You dance badly, laugh a lot, and walk home at dawn feeling about twenty.", "effects": [ { "type": "happiness", "amount": 6 } ] },
        "failure": { "text": "Someone's older brother asks who you are, loudly. You leave after ten minutes and walk home the long way.", "effects": [ { "type": "happiness", "amount": -3 } ] } }
    ]
  },
  {
    "id": "own_summer_job", "trigger": "self", "category": "life", "title": "A summer job",

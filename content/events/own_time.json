    "choices": [
      { "text": "[[1990: Pick strawberries || Work in a café]]", "hint": "Your own money, earned.", "effects": [ { "type": "money", "amount": 8000 }, { "type": "happiness", "amount": 1 }, { "type": "trait_add", "trait": "ambitious", "chance": 0.03 } ], "result": "Sore back, early mornings, and at the end of the summer more money than you have ever held." }
    ]
  },
  {

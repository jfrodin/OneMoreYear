    "choices": [
      { "text": "Report for duty", "chance": 0.9,
        "success": { "text": "Two years. One of them in the jungle. You come home thinner, older, and you do not talk about it at dinner.", "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "flag", "flag": "veteran" }, { "type": "attribute", "kind": "fitness", "amount": 6 }, { "type": "ailment_add", "kind": "trauma", "chance": 0.35 }, { "type": "trait_add", "trait": "resilient", "chance": 0.15 }, { "type": "memory", "kind": "vietnam", "text": "Vietnam", "impact": -25 } ] },
        "failure": { "text": "A mine on a trail in Quang Tri. You come home in a wheelchair and spend a year learning to walk again.", "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "flag", "flag": "veteran" }, { "type": "health", "amount": -35 }, { "type": "ailment_add", "kind": "trauma", "chance": 0.7 }, { "type": "memory", "kind": "vietnam", "text": "The trail in Quang Tri", "impact": -45 } ] } },
      { "text": "Ask for a student deferment", "requires": { "activity": "studying" }, "effects": [ { "type": "flag", "flag": "draft_settled" } ],
        "result": "As long as you are in college, you are safe. Your friend from high school is not in college." },
      { "text": "Go to Canada", "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "happiness", "amount": -6 },
          { "type": "memory", "kind": "canada", "text": "The years in Canada", "impact": -10 } ],
        "result": "You cross the border at night with one suitcase. Your father does not speak to you for nine years." },
      { "text": "Go to Sweden", "requires": { "minYear": 1967 }, "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "happiness", "amount": -4 }, { "type": "emigrate", "country": "sweden" },
          { "type": "memory", "kind": "deserter", "text": "Refusing the war and leaving for Sweden", "impact": -5 } ],
        "result": "Sweden gives Americans who refuse the war a place to stay. A cold airport, a social worker with good English, a room in Stockholm. Nobody at home will understand." },
      { "text": "Apply as a conscientious objector", "chance": 0.35, "chanceTraits": { "kind": 0.15, "brave": 0.1 },
        "success": { "text": "Two years as an orderly in a veterans' hospital instead. You see what the war does, from the other end.", "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "trait_add", "trait": "kind", "chance": 0.15 } ] },
        "failure": { "text": "The board says no. You report in March like everyone else.", "effects": [ { "type": "flag", "flag": "draft_settled" }, { "type": "flag", "flag": "veteran" }, { "type": "ailment_add", "kind": "trauma", "chance": 0.35 }, { "type": "memory", "kind": "vietnam", "text": "Vietnam", "impact": -25 } ] } }
    ]
  },
  {

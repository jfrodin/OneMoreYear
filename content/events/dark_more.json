// The dark themes in depth (docs/design-decisions.md). Sexual violence is only ever something that
// happens to the player or someone close – never something the player does – and is never described,
// only what follows. Suicide appears as grief, and as a darkest night where every choice reaches out.
[
  {
    "id": "assault_player", "title": "Afterwards", "content": [ "sexual_violence" ],
    "text": "It was someone you trusted enough to let into your flat. Afterwards you sit on the bathroom floor for a long time, and the world has changed shape.",
    "conditions": { "minAge": 16, "maxAge": 70, "notFlags": [ "survivor" ] }, "weight": 0.25, "cooldown": 0,
    "choices": [
      { "text": "Go to the police", "hint": "It is your word against his. It is still worth saying.",
        "chance": 0.35, "chanceTraits": { "brave": 0.1, "resilient": 0.05 },
        "success": { "text": "It takes a year and every ounce of strength you have. He is convicted.",
          "effects": [ { "type": "assaulted" }, { "type": "happiness", "amount": 8 }, { "type": "memory", "kind": "justice", "text": "The day the court believed me", "impact": 20 } ] },
        "failure": { "text": "The case is dropped for lack of evidence. The officer is kind, which almost makes it worse.",
          "effects": [ { "type": "assaulted" }, { "type": "happiness", "amount": -5 } ] } },
      { "text": "Tell someone close", "effects": [ { "type": "assaulted" }, { "type": "happiness", "amount": 4 } ],
        "result": "You call the one person you can. They come in the middle of the night and sit with you until morning." },
      { "text": "Tell no one", "effects": [ { "type": "assaulted" }, { "type": "trait_add", "trait": "paranoid", "chance": 0.2 } ],
        "result": "You go to work on Monday. Nobody can tell. That is the loneliest part." }
    ]
  },
  {

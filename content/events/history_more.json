    ]
  },
  {
    "id": "hist_oresund_bridge", "countries": [ "sweden" ], "trigger": "history", "title": "The bridge",
    "text": "The bridge to Denmark is open. For the first time since the Ice Age you can drive from Sweden to the continent.",

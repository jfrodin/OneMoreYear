// More moments of history, as the family lived them. Each only happens in its year or years. No dashes.
[
  {
    "id": "hist_polio_vaccine", "trigger": "history", "title": "The vaccine",
    "text": "Every summer for years, parents have kept children away from swimming pools for fear of polio. Now there is a vaccine, and the queue outside the clinic goes round the block.",
    "conditions": { "minAge": 3, "minYear": 1955, "maxYear": 1957 }, "weight": 4, "cooldown": 0,
    "choices": [
      { "text": "Stand in the queue", "effects": [ { "type": "health", "amount": 2 }, { "type": "happiness", "amount": 2 } ], "result": "A sugar lump or a sharp jab, depending on the year. Then summer, and the pools are full of children again." },
      { "text": "Wait and see", "effects": [ { "type": "happiness", "amount": -1 } ], "result": "You wait. Everyone else goes. By autumn you feel a little foolish, and go too." }
    ]
  },
  {
    "id": "hist_sputnik", "trigger": "history", "title": "Beep, beep",
    "text": "The Russians have put something into orbit. On the radio, a recording of its signal: a thin beep, from space, over and over.",
    "conditions": { "minAge": 6, "minYear": 1957, "maxYear": 1957 }, "weight": 5, "cooldown": 0,
    "choices": [
      { "text": "Go outside and look for it", "effects": [ { "type": "happiness", "amount": 3 }, { "type": "memory", "kind": "sputnik", "text": "Looking for Sputnik in the night sky", "impact": 8 } ], "result": "The whole street, on the pavement, pointing at stars. Someone is sure they see it. Maybe they did." },
      { "text": "Worry about what it means", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "If they can put that up there, what else can they put up there? The grown ups talk late into the night." }
    ]
  },
  {
    "id": "hist_ingo", "countries": [ "sweden" ], "trigger": "history", "title": "Ingo",
    "text": "Ingemar Johansson is fighting Floyd Patterson for the heavyweight title in New York. The fight is in the middle of the night, Swedish time. Nobody is sleeping.",
    "conditions": { "minAge": 6, "minYear": 1959, "maxYear": 1959 }, "weight": 5, "cooldown": 0,
    "choices": [
      { "text": "Stay up by the radio", "effects": [ { "type": "happiness", "amount": 6 }, { "type": "memory", "kind": "ingo", "text": "The night Ingo won", "impact": 10 } ], "result": "Third round. Patterson goes down seven times. The whole building is awake and shouting through the walls. At breakfast half the street is still hoarse." },
      { "text": "Sleep, read about it in the morning", "effects": [ { "type": "happiness", "amount": 2 } ], "result": "The headline is enormous. Nobody talks about anything else. You nod as if you had been up." }
    ]
  },
  {
    "id": "hist_norrmalmstorg", "countries": [ "sweden" ], "trigger": "history", "title": "Norrmalmstorg",
    "text": "A man has taken hostages in a bank vault in central Stockholm. It has been on television for days. The strangest part: the hostages seem to be on his side.",
    "conditions": { "minAge": 10, "minYear": 1973, "maxYear": 1973 }, "weight": 4, "cooldown": 0,
    "choices": [
      { "text": "Watch every minute of it", "effects": [ { "type": "happiness", "amount": 1 } ], "result": "Six days. Tear gas at the end, and nobody is hurt. A doctor gives the strange part a name, and the name goes round the world." },
      { "text": "Turn it off", "effects": [], "result": "You turn it off. Everyone else talks about it all week anyway." }
    ]
  },
  {
    "id": "hist_nixon", "countries": [ "usa" ], "trigger": "history", "title": "Resignation",
    "text": "The President is on television tonight. Everyone knows what he is going to say.",
    "conditions": { "minAge": 10, "minYear": 1974, "maxYear": 1974 }, "weight": 5, "cooldown": 0,
    "choices": [
      { "text": "Watch with the family", "effects": [ { "type": "memory", "kind": "nixon", "text": "The night Nixon resigned", "impact": 8 } ], "result": "He resigns. Somebody in the room says nothing for a long time, then: \"Well. The system works.\" Somebody else is not so sure." },
      { "text": "Go out", "effects": [ { "type": "happiness", "amount": 2 } ], "result": "The bar has the television on anyway. Somebody buys a round when it is over. Somebody else leaves." }
    ]
  },
  {
    "id": "hist_elvis_dies", "trigger": "history", "title": "The King",
    "text": "The radio interrupts the music to say that Elvis Presley is dead. Forty two years old.",
    "conditions": { "minAge": 12, "minYear": 1977, "maxYear": 1977 }, "weight": 3, "cooldown": 0,
    "choices": [
      { "text": "Play the old records", "effects": [ { "type": "happiness", "amount": -1 }, { "type": "memory", "kind": "elvis", "text": "Playing Elvis all night, the day he died", "impact": 6 } ], "result": "All night, every record you have. You were young when this music came. Now you are not." },
      { "text": "Shrug", "effects": [], "result": "Not your music. Your parents' music. Somebody older than you cries in the kitchen, and you do not understand it until much later." }
    ]
  },
  {
    "id": "hist_borg_mcenroe", "countries": [ "sweden" ], "trigger": "history", "title": "The tie break",
    "text": "The Wimbledon final. Björn Borg against John McEnroe. The fourth set tie break has been going on for twenty minutes, and the whole country has stopped.",
    "conditions": { "minAge": 6, "minYear": 1980, "maxYear": 1980 }, "weight": 5, "cooldown": 0,
    "choices": [
      { "text": "Watch to the last point", "effects": [ { "type": "happiness", "amount": 6 }, { "type": "memory", "kind": "borg", "text": "Borg against McEnroe, 1980", "impact": 10 } ], "result": "Eighteen to sixteen to McEnroe. Then Borg wins the fifth anyway, and falls to his knees on the grass, and so do you, in the living room." },
      { "text": "Go out in the sun", "effects": [ { "type": "happiness", "amount": 2 } ], "result": "The streets are empty. Every open window has the same commentary coming out of it. You hear the ending from a stranger's balcony." }
    ]
  },
  {
    "id": "hist_storkonflikten", "countries": [ "sweden" ], "trigger": "history", "title": "The big conflict",
    "text": "Strikes and lockouts across the country. Buses are not running, the ferries have stopped, and the shops are running out of things.",

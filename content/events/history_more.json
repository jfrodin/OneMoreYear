    "choices": [
      { "text": "Watch every game", "effects": [ { "type": "happiness", "amount": 6 }, { "type": "health", "amount": -1 }, { "type": "memory", "kind": "world_cup", "text": "The summer of 1994 and the bronze", "impact": 12 } ], "result": "A penalty shootout against Romania that nobody alive will forget, a loss to Brazil, then bronze. Half of Sweden goes to work on four hours' sleep and does not care." },

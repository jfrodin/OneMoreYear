  {
    "id": "hist_anna_lindh", "countries": [ "sweden" ], "trigger": "history", "title": "In the department store",
    "text": "The foreign minister, Anna Lindh, has been stabbed while shopping in a department store in Stockholm, without bodyguards. This morning she died.",

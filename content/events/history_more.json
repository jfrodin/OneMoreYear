    "choices": [
      { "text": "Call the number and give", "effects": [ { "type": "money", "amount": -500 }, { "type": "happiness", "amount": 4 }, { "type": "trait_add", "trait": "generous", "chance": 0.03 } ], "result": "The line is busy for an hour. Then it goes through. You stay up for Queen, and feel like part of something." },

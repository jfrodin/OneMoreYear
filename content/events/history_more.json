    "choices": [
      { "text": "Stay up watching", "effects": [ { "type": "happiness", "amount": -2 } ], "result": "You cannot look away, and you cannot quite believe it is real. You do not sleep well that winter." },
      { "text": "Turn it off", "effects": [], "result": "It is too much like a video game, and you do not like how that feels." }
    ]
  },
  {
    "id": "hist_world_cup_1994", "countries": [ "sweden" ], "trigger": "history", "title": "Bronze",
    "text": "Sweden is in the World Cup semi final in America. The games are in the middle of the night, and the whole country has given up sleeping for a month.",

    "choices": [
      { "text": "Stand with the union", "effects": [ { "type": "money", "amount": -6000 }, { "type": "trait_add", "trait": "loyal", "chance": 0.04 } ], "result": "Ten days. Strike pay, coffee on the picket line, an argument with a neighbour. It ends in a deal nobody is happy with." },
      { "text": "Keep your head down", "effects": [ { "type": "money", "amount": -3000 } ], "result": "You keep your head down. The money is short for a while. It passes." }
    ]
  },
  {
    "id": "hist_lennon", "trigger": "history", "title": "Imagine",
    "text": "John Lennon has been shot outside his home in New York. The radio is playing nothing but Beatles songs.",
    "conditions": { "minAge": 12, "minYear": 1980, "maxYear": 1980 }, "weight": 3, "cooldown": 0,
    "choices": [
      { "text": "Light a candle", "effects": [ { "type": "happiness", "amount": -2 }, { "type": "memory", "kind": "lennon", "text": "The day Lennon died", "impact": 8 } ], "result": "A candle in the window. Across the street, someone has done the same. You do not know them, but tonight you do." },
      { "text": "Turn the radio off", "effects": [ { "type": "happiness", "amount": -1 } ], "result": "You turn it off. The songs are everywhere anyway, all week." }

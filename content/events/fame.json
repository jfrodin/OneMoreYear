  },
  {
    "id": "self_try_writing", "trigger": "self", "category": "career", "title": "Try to get published",
    "conditions": { "minAge": 18, "minSkills": { "writing": 5 }, "notJobs": [ "writing" ] },
    "choices": [ { "text": "Finish the manuscript", "hint": "Publishers say no far more often than yes.", "effects": [ { "type": "queue_event", "event": "fame_manuscript" } ], "result": "You write the last chapter at three in the morning." } ]

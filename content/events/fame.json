  },
  {
    "id": "self_try_sport", "trigger": "self", "category": "career", "title": "Try to turn professional",
    "conditions": { "minAge": 16, "maxAge": 24, "minSkills": { "sport": 5 }, "notJobs": [ "sport" ] },
    "choices": [ { "text": "Ask for a trial", "hint": "Clubs take very few. The body has to be ready young.", "effects": [ { "type": "queue_event", "event": "fame_scout" } ], "result": "Your coach makes a phone call." } ]

[
  {
    "id": "ll_empty_room", "title": "The empty room",
    "text": "{t.name}'s room is empty now. The bed is made, the posters are gone, and nobody sleeps there.",
    "conditions": { "minAge": 40, "maxAge": 70 }, "cooldown": 15,
    "target": { "role": "child", "conditions": { "minAge": 19, "maxAge": 25 } },
    "choices": [
      { "text": "Leave it as it is, for now", "effects": [ { "type": "happiness", "amount": -2 }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 2 } ], "result": "You open the door sometimes and just stand there. When {t.name} comes home for Christmas, everything is where {t.he} left it." },
      { "text": "Make it into something of your own", "effects": [ { "type": "happiness", "amount": 3 } ], "result": "A sewing room, a study, a place for the exercise bike nobody uses. It is strange how quickly it becomes yours." }
    ]

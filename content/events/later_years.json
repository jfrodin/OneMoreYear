      { "text": "Help with the deposit instead", "requires": { "minMoney": 30000 }, "effects": [ { "type": "money", "amount": -30000 }, { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 4 } ], "result": "A transfer, and a new flat across town by the end of the month. Your house stays quiet. You are not sure whether you are relieved." },
      { "text": "It is time to stand on your own feet", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": -6 }, { "type": "relation", "who": "target", "to": "player", "dim": "respect", "amount": 3 } ], "result": "A long silence on the phone. {t.He} manages, in the end. Years later {t.he} says it was the best thing you ever did, and also the worst." }

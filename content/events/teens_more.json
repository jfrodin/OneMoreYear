    "choices": [
      { "text": "Be yourself", "chance": 0.6, "chanceTraits": { "charming": 0.15, "introvert": -0.1 },
        "success": { "text": "You start on Saturday. Stacking tins, at last a wage, and a manager who thinks you are reliable.", "effects": [ { "type": "money", "amount": 3000 }, { "type": "happiness", "amount": 4 } ] },

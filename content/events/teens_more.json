      { "text": "Exaggerate a little", "chance": 0.7, "chanceTraits": { "manipulative": 0.1, "dishonest": 0.1 },
        "success": { "text": "Previous experience in retail, you say, meaning the lemonade stand. You get the job.", "effects": [ { "type": "money", "amount": 3000 }, { "type": "trait_add", "trait": "dishonest", "chance": 0.03 } ] },
        "failure": { "text": "They ask a follow up question. You do not know what a till float is.", "effects": [ { "type": "happiness", "amount": -3 } ] } }

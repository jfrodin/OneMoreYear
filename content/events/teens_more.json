      { "text": "Run", "chance": 0.45, "chanceTraits": { "charming": 0.2, "social": 0.15, "ambitious": 0.1 },
        "success": { "text": "You win by eleven votes. You get the vending machine fixed, which is more than anyone expected.", "effects": [ { "type": "happiness", "amount": 6 }, { "type": "trait_add", "trait": "ambitious", "chance": 0.06 } ] },
        "failure": { "text": "You lose to someone whose campaign was free sweets. You learn something about politics.", "effects": [ { "type": "happiness", "amount": -3 } ] } },
      { "text": "Vote for someone else", "effects": [], "result": "Your candidate wins. They do nothing at all. You are not surprised." }
    ]
  },
  {
    "id": "teen2_glasses", "title": "The board",
    "text": "You cannot read the board any more, even from the front row. You have been squinting for months and telling no one.",
    "conditions": { "minAge": 11, "maxAge": 16, "activity": "school" }, "cooldown": 0, "weight": 0.6,
    "choices": [
      { "text": "Get glasses", "effects": [ { "type": "grades", "amount": 3 }, { "type": "happiness", "amount": 1 } ], "result": "Leaves on trees. Individual leaves! Nobody told you." },
      { "text": "Keep squinting", "effects": [ { "type": "grades", "amount": -2 } ], "result": "You copy from the person next to you. Their handwriting is worse than your eyesight." }
    ]
  },
  {
    "id": "teen2_rival_sibling", "title": "Compared",
    "text": "\"{T.role} was so good at this,\" says the teacher, for the third time this term. {T.name} went to this school before you, and everybody remembers.",
    "target": { "role": "sibling", "conditions": { "minAge": 15 } },
    "conditions": { "minAge": 12, "maxAge": 17, "activity": "school" }, "cooldown": 0,
    "choices": [
      { "text": "Try to beat {t.him}", "effects": [ { "type": "grades", "amount": 3 }, { "type": "relation", "who": "player", "to": "target", "dim": "envy", "amount": 6 }, { "type": "trait_add", "trait": "ambitious", "chance": 0.05 } ], "result": "You work harder than you ever have. Your grades are better. You are not sure you are happier." },
      { "text": "Be good at something else", "effects": [ { "type": "happiness", "amount": 3 }, { "type": "trait_add", "trait": "creative", "chance": 0.05 } ], "result": "Drama club. Nobody in your family has ever been in drama club. It is all yours." }
    ]
  },
  {
    "id": "teen2_sports_injury", "title": "The knee",
    "text": "A bad landing in the match. Your knee makes a sound that makes the whole bench go quiet.",
    "conditions": { "minAge": 13, "maxAge": 18 }, "cooldown": 0, "weight": 0.5,
    "choices": [
      { "text": "Do all the rehab", "effects": [ { "type": "health", "amount": -2 }, { "type": "trait_add", "trait": "resilient", "chance": 0.08 } ], "result": "Six months of boring exercises with an elastic band. You play again by spring, a little slower, a lot wiser." },
      { "text": "Give up the sport", "effects": [ { "type": "health", "amount": -3 }, { "type": "happiness", "amount": -3 } ], "result": "You never go back. The knee aches when it rains, for the rest of your life, to remind you." }
    ]

  {
    "id": "teen2_dinner_argument", "title": "At the dinner table",
    "text": "Dinner. You have just learned something at school that makes everything your parents believe seem wrong, and you have decided to share it.",
    "conditions": { "minAge": 14, "maxAge": 18 }, "cooldown": 0,
    "choices": [
      { "text": "Argue until dessert", "effects": [ { "type": "attribute", "kind": "smarts", "amount": 1 }, { "type": "happiness", "amount": 1 } ], "result": "Raised voices, a slammed door, and two days later your father brings it up again, quietly, to say you had a point." },
      { "text": "Keep it to yourself", "effects": [ { "type": "trait_add", "trait": "conflict_averse", "chance": 0.04 } ], "result": "You keep it in your head. It grows there, which is maybe the point." }

        "failure": { "text": "The regulator notices the trades. A hearing, a fine, a job gone.", "effects": [ { "type": "money", "amount": -300000 }, { "type": "fire" }, { "type": "happiness", "amount": -12 } ] } },
      { "text": "Forget you heard it", "effects": [ { "type": "trait_add", "trait": "loyal", "chance": 0.03 } ], "result": "The deal is announced on a Tuesday. You watch the price jump and feel, mostly, clean." }
    ]

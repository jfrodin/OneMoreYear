        "failure": { "text": "You misread it. His sums were fine. Monday is lost, and so is a little of everyone's patience with you.", "effects": [ { "type": "performance", "amount": -8 } ] } },
      { "text": "Mention it in an email", "effects": [ { "type": "performance", "amount": 2 } ], "result": "He checks it on Friday evening and quietly fixes it. Nobody mentions your email again, but he asks for you on the next project." }
    ]
  },
  {
    "id": "wt_science_result", "title": "The result",
    "text": "After two years, the experiment has produced a result nobody expected. If it is true, it is important. If it is a mistake, it is embarrassing.",
    "conditions": { "minAge": 25, "jobs": [ "science" ] }, "cooldown": 10,
    "choices": [

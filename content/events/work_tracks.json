  {
    "id": "wt_engineer_bridge", "title": "The calculation",
    "text": "Checking the drawings for a new bridge, you find an error in someone else's calculation. A senior engineer's. The concrete is booked for Monday.",
    "conditions": { "minAge": 24, "jobs": [ "engineering" ] }, "cooldown": 12,

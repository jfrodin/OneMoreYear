// Stories from particular jobs, one or two for each track. No dashes.
[
  {
    "id": "wt_med_night_shift", "title": "The night shift",
    "text": "Three in the morning in the emergency room. A child with a fever, a drunk with a cut head, and a man who is not saying how much his chest hurts.",
    "conditions": { "minAge": 24, "jobs": [ "medicine" ] }, "cooldown": 6,
    "choices": [
      { "text": "Trust the feeling about the quiet man", "chance": 0.7, "chanceAttributes": { "smarts": 0.004 },
        "success": { "text": "An ECG, a phone call, the cath lab at four. He lives. His wife finds out your name and sends flowers to the ward every year.", "effects": [ { "type": "performance", "amount": 10 }, { "type": "happiness", "amount": 6 }, { "type": "memory", "kind": "saved_patient", "text": "The quiet man with the chest pain", "impact": 20 } ] },
        "failure": { "text": "You were right to look, but it was nothing. The child's fever, meanwhile, waited too long. A complaint follows.", "effects": [ { "type": "performance", "amount": -5 }, { "type": "happiness", "amount": -3 } ] } },
      { "text": "Take them in order", "effects": [ { "type": "performance", "amount": 2 } ], "result": "By the book. It works, this time. You drive home at dawn and cannot remember the drive." }
    ]
  },
  {
    "id": "wt_med_mistake", "title": "The wrong dose",
    "text": "You notice it too late: the dose you wrote yesterday was ten times what it should have been. The patient is fine, so far. Nobody else has noticed.",
    "conditions": { "minAge": 24, "jobs": [ "medicine", "healthcare" ] }, "cooldown": 15, "weight": 0.6,
    "choices": [
      { "text": "Report it yourself", "effects": [ { "type": "performance", "amount": -4 }, { "type": "trait_add", "trait": "brave", "chance": 0.05 }, { "type": "happiness", "amount": -3 } ], "result": "A meeting, a form, a new routine on the ward because of you. Your boss says it is the kind of thing that makes a good doctor. It does not feel like it." },
      { "text": "Fix it quietly", "chance": 0.75,
        "success": { "text": "Nobody ever finds out. You check every dose three times for the rest of your career.", "effects": [ { "type": "trait_add", "trait": "paranoid", "chance": 0.05 } ] },
        "failure": { "text": "A nurse noticed, and reported it. Now it is about the hiding, not the mistake.", "effects": [ { "type": "fire" }, { "type": "happiness", "amount": -10 } ] } }
    ]
  },
  {
    "id": "wt_care_last_patient", "title": "Room six",
    "text": "The old man in room six has nobody. No visitors, no calls. Tonight the doctor says it will not be long.",
    "conditions": { "minAge": 20, "jobs": [ "healthcare" ] }, "cooldown": 8,
    "choices": [
      { "text": "Stay with him after your shift", "effects": [ { "type": "happiness", "amount": 2 }, { "type": "trait_add", "trait": "kind", "chance": 0.05 }, { "type": "memory", "kind": "room_six", "text": "Holding the hand of the man in room six", "impact": 15 } ], "result": "You hold his hand and talk about nothing. Near the end he squeezes once. You go home and sleep for twelve hours." },
      { "text": "Go home, you are exhausted", "effects": [ { "type": "health", "amount": 1 } ], "result": "He dies at four, with a night nurse who did not know his name. You think about it on your next shift, and the one after." }
    ]
  },
  {
    "id": "wt_law_client", "title": "Guilty",
    "text": "Your client tells you, quietly, in the meeting room, that he did it. The trial starts on Monday.",
    "conditions": { "minAge": 25, "jobs": [ "law" ] }, "cooldown": 10,
    "choices": [
      { "text": "Defend him anyway, properly", "chance": 0.4, "chanceAttributes": { "smarts": 0.005 },
        "success": { "text": "Acquitted. The prosecution made mistakes and you found every one. You do not go to the celebration.", "effects": [ { "type": "performance", "amount": 10 }, { "type": "happiness", "amount": -3 } ] },
        "failure": { "text": "Convicted. You did your job. He spits at you on the way out.", "effects": [ { "type": "performance", "amount": 2 } ] } },
      { "text": "Ask to be taken off the case", "effects": [ { "type": "performance", "amount": -5 }, { "type": "happiness", "amount": 2 } ], "result": "The senior partner looks at you for a long time. \"You are in the wrong job,\" he says. Maybe." }
    ]
  },
  {
    "id": "wt_law_pro_bono", "title": "For nothing",
    "text": "A woman is being evicted with three children, by a landlord with a lot of money and a lot of lawyers. She cannot pay anyone. She has asked you.",
    "conditions": { "minAge": 25, "jobs": [ "law" ] }, "cooldown": 10,
    "choices": [
      { "text": "Take the case for free", "chance": 0.55, "chanceAttributes": { "smarts": 0.004 },
        "success": { "text": "You win. She stays. Her youngest draws you a picture of a house with a lawyer in it, and you keep it on your desk for thirty years.", "effects": [ { "type": "happiness", "amount": 8 }, { "type": "performance", "amount": -3 }, { "type": "trait_add", "trait": "generous", "chance": 0.05 } ] },
        "failure": { "text": "You lose. You find her a flat through a friend of a friend. It is not what she asked for, but it is something.", "effects": [ { "type": "happiness", "amount": -2 }, { "type": "performance", "amount": -3 } ] } },
      { "text": "Refer her on", "effects": [], "result": "A name and a number at legal aid. You do not hear what happened. You do not ask." }
    ]
  },
  {
    "id": "wt_it_outage", "title": "Everything is down",
    "text": "Friday afternoon, the whole system is down, and it is your code from Wednesday. The phone will not stop ringing.",
    "conditions": { "minAge": 20, "jobs": [ "it" ] }, "cooldown": 6,
    "choices": [
      { "text": "Stay all weekend and fix it", "chance": 0.7, "chanceSkills": { "programming": 0.04 },
        "success": { "text": "Three in the morning on Sunday, the last test goes green. On Monday your boss thanks the whole team. You know.", "effects": [ { "type": "performance", "amount": 8 }, { "type": "health", "amount": -2 } ] },
        "failure": { "text": "You make it worse before it gets better. It is fixed on Tuesday, by someone else.", "effects": [ { "type": "performance", "amount": -8 }, { "type": "happiness", "amount": -4 } ] } },
      { "text": "Roll it back and own up", "effects": [ { "type": "performance", "amount": 2 }, { "type": "trait_add", "trait": "resilient", "chance": 0.03 } ], "result": "\"My change, my mistake, rolled back.\" Ten minutes. People respect it more than you expected." }
    ]
  },
  {
    "id": "wt_it_startup_offer", "title": "The start up",
    "text": "A former colleague is starting a company and wants you with them. Half the salary, a pile of shares, and an office above a pizza place.",
    "conditions": { "minAge": 23, "maxAge": 50, "jobs": [ "it", "engineering" ], "minYear": 1995 }, "cooldown": 15,
    "choices": [
      { "text": "Jump", "chance": 0.15, "chanceTraits": { "ambitious": 0.1, "brave": 0.05 },
        "success": { "text": "Four years of pizza and panic, and then a much bigger company buys yours. The shares are worth more than you will earn in the rest of your life.", "effects": [ { "type": "money", "amount": 4000000 }, { "type": "happiness", "amount": 12 }, { "type": "memory", "kind": "startup_exit", "text": "The day they bought our company", "impact": 30 } ] },
        "failure": { "text": "Two years, then the money runs out. The shares are worth nothing. You learned more than in ten years anywhere else, which is what people say.", "effects": [ { "type": "money", "amount": -150000 }, { "type": "happiness", "amount": -5 }, { "type": "skill", "kind": "programming", "amount": 1 } ] } },
      { "text": "Stay where you are", "effects": [], "result": "You wish them luck and mean it. Every few years you look up the company. Sometimes you are relieved." }
    ]
  },
  {
    "id": "wt_media_scoop", "title": "The story",
    "text": "A source has given you documents showing that a local politician has been taking money. It is the biggest story you have ever had. The editor is nervous.",
    "conditions": { "minAge": 22, "jobs": [ "media" ] }, "cooldown": 10,
    "choices": [
      { "text": "Push to publish", "chance": 0.6, "chanceTraits": { "brave": 0.15 },
        "success": { "text": "Front page. The politician resigns within a week. You get a prize, and a lot of letters, not all of them nice.", "effects": [ { "type": "performance", "amount": 12 }, { "type": "fame", "amount": 4 }, { "type": "happiness", "amount": 6 } ] },
        "failure": { "text": "One of the documents is fake. The paper prints a correction, and so does your career.", "effects": [ { "type": "performance", "amount": -15 }, { "type": "happiness", "amount": -8 } ] } },
      { "text": "Check everything twice more", "effects": [ { "type": "performance", "amount": 3 } ], "result": "It takes three months. Another paper runs it first, with half the facts. Yours is the better story, read by fewer people." }
    ]
  },
  {
    "id": "wt_academia_tenure", "title": "The paper",
    "text": "Your big paper has come back from review. One reviewer loves it. The other has written four pages explaining why you are wrong.",
    "conditions": { "minAge": 26, "jobs": [ "academia", "science" ] }, "cooldown": 6,
    "choices": [
      { "text": "Rewrite it, all of it", "chance": 0.6, "chanceAttributes": { "smarts": 0.005 },
        "success": { "text": "Accepted, in the journal everyone reads. Cited three hundred times. Reviewer two writes to you years later to say it changed his mind.", "effects": [ { "type": "performance", "amount": 10 }, { "type": "happiness", "amount": 5 } ] },
        "failure": { "text": "Rejected anyway. You send it somewhere smaller. It does fine there. You know what it could have been.", "effects": [ { "type": "performance", "amount": -3 }, { "type": "happiness", "amount": -3 } ] } },
      { "text": "Argue with reviewer two", "effects": [ { "type": "performance", "amount": -2 }, { "type": "trait_add", "trait": "hot_tempered", "chance": 0.03 } ], "result": "A long, polite, furious letter. It feels wonderful to write. It changes nothing." }
    ]
  },
  {
    "id": "wt_teacher_difficult_pupil", "title": "The boy at the back",
    "text": "There is a boy at the back of the class who disrupts every lesson. Other teachers have given up on him. Today he stayed behind, as if he wanted to say something.",
    "conditions": { "minAge": 23, "jobs": [ "education" ] }, "cooldown": 8,
    "choices": [
      { "text": "Ask him how things are at home", "chance": 0.6, "chanceTraits": { "kind": 0.15 },
        "success": { "text": "It comes out slowly, over weeks. You make some calls. He still disrupts lessons, but less, and he comes to all of them. Fifteen years later he finds you online to say thank you.", "effects": [ { "type": "happiness", "amount": 8 }, { "type": "performance", "amount": 4 }, { "type": "memory", "kind": "pupil", "text": "The boy at the back who came to thank me", "impact": 20 } ] },
        "failure": { "text": "He shrugs and leaves. The next day he is worse. You tried. You keep trying, for a while.", "effects": [ { "type": "happiness", "amount": -2 } ] } },
      { "text": "Remind him about homework", "effects": [], "result": "He nods and goes. Whatever it was, he does not try again." }
    ]
  },
  {
    "id": "wt_construction_corner", "title": "Cutting corners",
    "text": "The foreman wants the scaffolding up today, without the second set of anchors. The inspector is not due until Thursday.",
    "conditions": { "minAge": 18, "jobs": [ "construction" ] }, "cooldown": 8,
    "choices": [
      { "text": "Refuse to climb it", "chance": 0.7,
        "success": { "text": "He swears for a while, then sends for the anchors. Two weeks later the wind comes. Everything holds.", "effects": [ { "type": "performance", "amount": 2 }, { "type": "trait_add", "trait": "brave", "chance": 0.03 } ] },
        "failure": { "text": "He finds someone who will. You are on the next job list, last.", "effects": [ { "type": "performance", "amount": -6 } ] } },
      { "text": "Do as you are told", "chance": 0.9,
        "success": { "text": "It holds. It usually does. That is the problem with usually.", "effects": [ { "type": "performance", "amount": 3 } ] },
        "failure": { "text": "A gust, a lurch, a fall of four metres. Your back is never quite the same.", "effects": [ { "type": "health", "amount": -15 }, { "type": "happiness", "amount": -8 } ] } }
    ]
  },
  {
    "id": "wt_industry_line", "title": "The line",
    "text": "The factory is bringing in machines that do in an hour what your shift does in a day. There is a meeting about \"the future of the workforce\".",
    "conditions": { "minAge": 20, "jobs": [ "industry" ], "minYear": 1975 }, "cooldown": 15,
    "choices": [
      { "text": "Learn to run the new machines", "chance": 0.6, "chanceAttributes": { "smarts": 0.005 },
        "success": { "text": "Evening courses, a certificate, a new title. Half your old shift is gone by Christmas. You are still there, and it does not feel like winning.", "effects": [ { "type": "promote" }, { "type": "happiness", "amount": -2 } ] },
        "failure": { "text": "You try. The manuals are in a language made of abbreviations. You are on the list in spring.", "effects": [ { "type": "fire" }, { "type": "happiness", "amount": -8 } ] } },
      { "text": "Stand with the union", "effects": [ { "type": "trait_add", "trait": "loyal", "chance": 0.05 }, { "type": "performance", "amount": -3 } ], "result": "A strike, a deal, a slower change. Some jobs are saved. Yours, for now." }
    ]
  },
  {
    "id": "wt_restaurant_critic", "title": "The critic",
    "text": "A waiter comes into the kitchen white in the face: the critic from the big paper is at table nine, alone, ordering the fish.",

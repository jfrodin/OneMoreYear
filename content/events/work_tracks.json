        "failure": { "text": "A roadside bomb, a convoy, a friend who does not come home. You do.", "effects": [ { "type": "health", "amount": -10 }, { "type": "happiness", "amount": -15 }, { "type": "ailment_add", "kind": "trauma", "chance": 0.6 } ] } },
      { "text": "Ask to stay for family reasons", "requires": { "minChildren": 1 }, "effects": [ { "type": "performance", "amount": -6 } ], "result": "Granted, this time. A colleague goes in your place. You read every report from the mission twice." }

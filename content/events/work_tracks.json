        "failure": { "text": "The third run shows it: a contaminated sample. Two years, back to the start. At least you were the one to find it.", "effects": [ { "type": "performance", "amount": -3 }, { "type": "happiness", "amount": -6 } ] } },
      { "text": "Publish quickly before someone else does", "chance": 0.3,
        "success": { "text": "You were first, and you were right. Lucky, and you know it.", "effects": [ { "type": "performance", "amount": 12 }, { "type": "fame", "amount": 3 } ] },
        "failure": { "text": "Another lab cannot repeat it. A retraction, with your name on it.", "effects": [ { "type": "performance", "amount": -15 }, { "type": "happiness", "amount": -10 } ] } }
    ]
  },
  {

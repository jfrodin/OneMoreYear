    "target": { "role": "colleague" },
    "choices": [
      { "text": "Report him", "chance": 0.6,
        "success": { "text": "An investigation, a dismissal for {t.name}, and a station that is very quiet when you walk in for a year. Then people start to trust you.", "effects": [ { "type": "trait_add", "trait": "brave", "chance": 0.08 }, { "type": "performance", "amount": 4 }, { "type": "happiness", "amount": -4 } ] },
        "failure": { "text": "Nothing happens to {t.him}. Things start happening to you: the worst shifts, a backup that comes slowly.", "effects": [ { "type": "performance", "amount": -10 }, { "type": "happiness", "amount": -8 } ] } },
      { "text": "Say nothing", "effects": [ { "type": "trait_add", "trait": "dishonest", "chance": 0.05 }, { "type": "happiness", "amount": -4 } ], "result": "{t.He} buys you lunch the next day. You eat it. It tastes of nothing." }
    ]
  },
  {

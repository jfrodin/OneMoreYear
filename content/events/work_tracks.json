        "failure": { "text": "Two stars. \"The fish was confident. It was also overcooked.\" The owner reads it aloud in the kitchen.", "effects": [ { "type": "performance", "amount": -8 }, { "type": "happiness", "amount": -5 } ] } },
      { "text": "Treat table nine like any other", "effects": [ { "type": "performance", "amount": 2 } ], "result": "Three stars. A good, honest review. Nobody frames it." }
    ]
  },
  {
    "id": "wt_driver_lonely_road", "title": "The night road",
    "text": "The last stretch of a long run, two in the morning, the road empty and straight. Your eyes keep closing.",
    "conditions": { "minAge": 21, "jobs": [ "transport" ] }, "cooldown": 6,
    "choices": [
      { "text": "Pull over and sleep in the cab", "effects": [ { "type": "performance", "amount": -3 }, { "type": "health", "amount": 1 } ], "result": "Late by three hours. The depot complains. You are alive to hear it." },
      { "text": "Window down, radio up, push on", "chance": 0.85,
        "success": { "text": "You make it. You do not remember the last forty kilometres, which frightens you more than anything.", "effects": [ { "type": "performance", "amount": 3 } ] },
        "failure": { "text": "A jolt, gravel, the ditch. The truck is a write off. You walk away with a broken arm and a lot of paperwork.", "effects": [ { "type": "health", "amount": -12 }, { "type": "fire" }, { "type": "happiness", "amount": -8 } ] } }
    ]
  },
  {
    "id": "wt_police_colleague", "title": "The colleague",
    "text": "You saw {t.name}, your partner on patrol, take money from a driver {t.he} had just stopped. {t.He} knows you saw.",

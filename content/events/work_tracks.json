    "choices": [
      { "text": "Come back unannounced", "chance": 0.6,
        "success": { "text": "The second time, the truth is in the fridge and the bruises. The child is safe by evening. The mother screams at you on the stairs. You will hear it for years.", "effects": [ { "type": "performance", "amount": 6 }, { "type": "happiness", "amount": -2 }, { "type": "memory", "kind": "the_visit", "text": "The child I got out", "impact": 20 } ] },

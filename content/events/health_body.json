        "failure": { "text": "A crack you hear before you feel. Six weeks in plaster and a story you will tell for life, improving it each time.", "effects": [ { "type": "health", "amount": -8 }, { "type": "happiness", "amount": -3 } ] } },
      { "text": "Take the lift down", "effects": [ { "type": "happiness", "amount": -1 } ], "result": "Your friends tease you all evening. Your legs are perfectly fine. You will be skiing at eighty, and they will not." }

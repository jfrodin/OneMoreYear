        "success": { "text": "Less salt, more walking, fewer late nights. A year later the numbers are normal, and you feel ten years younger.", "effects": [ { "type": "health", "amount": 5 }, { "type": "attribute", "kind": "fitness", "amount": 2 } ] },
        "failure": { "text": "Two good months, then old habits. You take the pills instead. They work, mostly.", "effects": [ { "type": "health", "amount": 1 } ] } },
      { "text": "Take the pills", "effects": [ { "type": "health", "amount": 2 } ], "result": "One small pill every morning, for the rest of your life. It is a fair deal, all things considered." }
    ]

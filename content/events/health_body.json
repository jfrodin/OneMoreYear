        "success": { "text": "It stops hurting by itself. You decide not to think about why.", "effects": [] },
        "failure": { "text": "A root canal, at three times the price, on a Friday afternoon. The dentist does not say I told you so. Her face does.", "effects": [ { "type": "money", "amount": -8000 }, { "type": "health", "amount": -2 } ] } }
    ]
  },
  {
    "id": "hb_blood_pressure", "group": "health_numbers", "title": "The numbers",

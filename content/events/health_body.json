    "choices": [
      { "text": "Stay in bed", "effects": [ { "type": "health", "amount": 1 }, { "type": "performance", "amount": -1 } ], "result": "Five days of soup, daytime television and sleep. You come back to a desk that survived without you." },
      { "text": "Go in anyway", "effects": [ { "type": "health", "amount": -3 }, { "type": "performance", "amount": 1 } ], "result": "You make it through the day. So does the virus, which spreads through the whole office. Nobody thanks you." }

        "failure": { "text": "It floods the kitchen. They buy a new one. They still say hello, just a little less warmly.", "effects": [ { "type": "happiness", "amount": -2 } ] } },
      { "text": "Say you are busy", "effects": [], "result": "There is a queue at your door by Easter anyway. Word has got around." }
    ]
  },
  {

      { "text": "Enter", "chance": 0.3, "chanceSkills": { "gardening": 0.06 },
        "success": { "text": "First prize. A red rosette, a certificate, and the neighbour not speaking to you until autumn. Perfect.", "effects": [ { "type": "happiness", "amount": 6 } ] },
        "failure": { "text": "Highly commended. The neighbour wins. He is very gracious about it, which is unforgivable.", "effects": [ { "type": "happiness", "amount": -1 } ] } },
      { "text": "Give them away instead", "effects": [ { "type": "happiness", "amount": 3 }, { "type": "trait_add", "trait": "generous", "chance": 0.03 } ], "result": "Bags of tomatoes on every doorstep on the street. Better than a rosette, mostly." }

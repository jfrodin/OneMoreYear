// Hobbies and skills (SkillSystem). "hobby" sets the hobby; "minSkills" and "chanceSkills" use the
// skill levels, 0 to 10. No dashes.
[
  {
    "id": "self_take_up_hobby", "trigger": "self", "category": "life", "title": "Take up a hobby",
    "conditions": { "minAge": 10 },
    "choices": [
      { "text": "Cooking", "hint": "From burnt toast to a Sunday roast that people talk about.", "effects": [ { "type": "hobby", "kind": "cooking" } ], "result": "A cookbook, a sharp knife and a lot of smoke in the kitchen for the first month." },
      { "text": "Painting", "hint": "Watercolours at the kitchen table, then maybe a gallery.", "effects": [ { "type": "hobby", "kind": "painting" } ], "result": "A box of paints, a pad of paper and a first painting of a bowl of fruit that you hide from everyone." },
      { "text": "Music", "hint": "An instrument that slowly stops being furniture.", "effects": [ { "type": "hobby", "kind": "music" } ], "result": "A second hand guitar and three chords. The neighbours learn them too." },
      { "text": "Writing", "hint": "Notebooks, stories, and perhaps a book one day.", "effects": [ { "type": "hobby", "kind": "writing" } ], "result": "A notebook you carry everywhere and write in when nobody is looking." },
      { "text": "Gardening", "hint": "Tomatoes nobody can buy in a shop.", "effects": [ { "type": "hobby", "kind": "gardening" } ], "result": "Seeds on the windowsill. Most of them come up. You are absurdly proud." },
      { "text": "Fixing things", "hint": "Shelves, taps, cars, other people's shelves.", "effects": [ { "type": "hobby", "kind": "handiness" } ], "result": "A toolbox and a broken radio from a flea market. It works by Sunday." },
      { "text": "Sport", "hint": "Running, football, swimming, whatever keeps you moving.", "effects": [ { "type": "hobby", "kind": "sport" }, { "type": "attribute", "kind": "fitness", "amount": 2 } ], "result": "New shoes and a route around the lake. The first week hurts. The third does not." },
      { "text": "Chess", "hint": "Sixty four squares and a lifetime of learning.", "effects": [ { "type": "hobby", "kind": "chess" } ], "result": "A board, a book of openings, and a club that meets in the library on Wednesdays." },
      { "text": "Programming", "requires": { "minYear": 1978 }, "hint": "Making the machine do what you want, one line at a time.", "effects": [ { "type": "hobby", "kind": "programming" } ], "result": "A blinking cursor at midnight, and a program that finally does what you meant." },
      { "text": "Not now", "result": "There is never enough time. Maybe next year." }
    ]
  },
  {
    "id": "hob_cook_dinner", "title": "Dinner for eight",
    "text": "You have offered to cook for eight at your place. Someone's very particular in law is coming.",
    "conditions": { "minAge": 20, "hobby": "cooking" }, "cooldown": 6,
    "choices": [
      { "text": "Try something ambitious", "chance": 0.35, "chanceSkills": { "cooking": 0.06 },
        "success": { "text": "Three courses, a sauce you had never made before, and silence at the table, the good kind. The in law asks for the recipe.", "effects": [ { "type": "happiness", "amount": 6 }, { "type": "skill", "kind": "cooking", "amount": 1 } ] },
        "failure": { "text": "The sauce splits, the meat is grey. You order pizza and everyone pretends it was the plan.", "effects": [ { "type": "happiness", "amount": -2 } ] } },
      { "text": "Cook what you know", "chance": 0.6, "chanceSkills": { "cooking": 0.04 },
        "success": { "text": "Your best dish, done perfectly. A lovely, unremarkable, happy evening.", "effects": [ { "type": "happiness", "amount": 4 } ] },
        "failure": { "text": "Even your best dish has an off night. Nobody says anything. Everybody eats bread.", "effects": [ { "type": "happiness", "amount": -1 } ] } }
    ]
  },
  {
    "id": "hob_paint_sell", "title": "Someone wants to buy",
    "text": "A visitor stops in front of a painting on your wall and asks, quite seriously, how much you want for it.",
    "conditions": { "minAge": 18, "minSkills": { "painting": 5 } }, "cooldown": 6,
    "choices": [
      { "text": "Sell it", "effects": [ { "type": "money", "amount": 8000 }, { "type": "happiness", "amount": 5 } ], "result": "Your first sale. You spend the money on better paint and keep the receipt forever." },
      { "text": "It is not for sale", "effects": [ { "type": "happiness", "amount": 3 } ], "result": "You say no, and paint another one for them instead. Better, you think." }
    ]
  },
  {
    "id": "hob_paint_exhibition", "title": "A small show",
    "text": "The local library wants to show your paintings for a month. Twenty walls, an opening on a Friday, and your name on a little card.",
    "conditions": { "minAge": 20, "minSkills": { "painting": 7 } }, "cooldown": 15,
    "choices": [
      { "text": "Say yes", "chance": 0.5, "chanceSkills": { "painting": 0.04 },
        "success": { "text": "Six paintings sell. A local newspaper writes a paragraph. Your family comes, all of them, and stands in front of the one of the old house for a long time.", "effects": [ { "type": "money", "amount": 30000 }, { "type": "happiness", "amount": 8 }, { "type": "memory", "kind": "exhibition", "text": "My paintings on the library walls", "impact": 20 } ] },
        "failure": { "text": "One sale, to an aunt. But people stopped and looked, and that is something.", "effects": [ { "type": "money", "amount": 3000 }, { "type": "happiness", "amount": 2 } ] } },
      { "text": "You are not ready", "effects": [], "result": "You will never feel ready. That is the problem, a friend tells you." }
    ]
  },
  {
    "id": "hob_music_gig", "title": "Open mic",
    "text": "An open mic night at the pub. Your name is on the list, fourth. Your hands are shaking.",
    "conditions": { "minAge": 16, "minSkills": { "music": 3 } }, "cooldown": 5,

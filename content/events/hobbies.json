      { "text": "Play your own song", "chance": 0.4, "chanceSkills": { "music": 0.06 }, "chanceTraits": { "charming": 0.1 },
        "success": { "text": "The room goes quiet halfway through. Then real applause, and the owner asks if you can do a whole evening next month.", "effects": [ { "type": "happiness", "amount": 7 }, { "type": "money", "amount": 1500 }, { "type": "skill", "kind": "music", "amount": 1 } ] },
        "failure": { "text": "You forget the second verse and hum it. People clap anyway, kindly. You go home and practise until three.", "effects": [ { "type": "happiness", "amount": -1 } ] } },
      { "text": "Play a song everyone knows", "effects": [ { "type": "happiness", "amount": 4 } ], "result": "The whole pub sings the chorus. Not your song, but your night." }
    ]
  },
  {
    "id": "hob_music_wedding", "title": "The wedding band",
    "text": "A friend's band has lost their player two weeks before a wedding gig. They have heard you play. The pay is good.",
    "conditions": { "minAge": 18, "minSkills": { "music": 6 } }, "cooldown": 8,
    "choices": [
      { "text": "Learn twenty songs in two weeks", "chance": 0.6, "chanceSkills": { "music": 0.04 },
        "success": { "text": "A marquee, a dance floor, a bride crying at the first dance. You play until one and they ask you to join the band permanently.", "effects": [ { "type": "money", "amount": 6000 }, { "type": "happiness", "amount": 6 } ] },
        "failure": { "text": "You fake your way through the middle eight of four songs. Nobody on the dance floor notices. The drummer does.", "effects": [ { "type": "money", "amount": 6000 }, { "type": "happiness", "amount": 1 } ] } },
      { "text": "Say no", "effects": [], "result": "They find someone else. You hear afterwards that the bride cried at the first dance. You wish it had been your guitar." }
    ]
  },
  {
    "id": "hob_writing_novel", "title": "The manuscript",
    "text": "After years of evenings, the novel is finished. Three hundred pages in a drawer. A publisher is accepting submissions.",

        "failure": { "text": "They cut it to two lines that make you sound mad. You learn something about editors.", "effects": [ { "type": "happiness", "amount": -2 } ] } },
      { "text": "Let it go", "effects": [], "result": "You write it anyway, and never send it. It is very good." }
    ]
  },
  {
    "id": "hob_garden_show", "title": "The vegetable show",
    "text": "The village show is on Saturday. Your tomatoes are, you secretly believe, the best in the district. So does the man next door about his.",

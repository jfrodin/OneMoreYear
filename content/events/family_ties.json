        "failure": { "text": "Your youngest relative starts crying and does not stop. The photographer charges extra.", "effects": [ { "type": "happiness", "amount": -1 } ] } }
    ]
  },
  {
    "id": "ties_sibling_rivalry_adult", "title": "Who did better",
    "text": "{t.name} has bought a house with a sea view. At the housewarming {t.he} shows you the wine cellar twice.",
    "conditions": { "minAge": 28 },
    "target": { "role": "sibling", "conditions": { "minAge": 28, "ownsHome": true } }, "cooldown": 15,
    "choices": [
      { "text": "Be happy for {t.him}", "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "closeness", "amount": 6 }, { "type": "happiness", "amount": 1 } ],
        "result": "Later, on the balcony, {t.he} admits the mortgage keeps {t.him} awake at night." },
      { "text": "Mention your own promotion", "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "envy", "amount": 5 } ], "result": "Neither of you is listening. Your mother is very proud of both of you." },
      { "text": "Ask how much it cost", "requires": { "traitsAny": [ "greedy", "impulsive", "stingy" ] }, "effects": [ { "type": "relation", "who": "target", "to": "player", "dim": "bitterness", "amount": 5 } ],
        "result": "There is a short silence in which the whole party hears the dishwasher." }
    ]
  },
  {
    "id": "ties_half_sibling", "title": "Someone at the door",
    "text": "A young woman at the door says she thinks you have the same father. She has his chin. She has your chin.",
    "conditions": { "minAge": 25 },
    "target": { "role": "parent", "conditions": { "sex": "male", "traitsAny": [ "unfaithful" ] } }, "cooldown": 60, "weight": 0.3,

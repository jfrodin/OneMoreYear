    "choices": [
      { "text": "Ask her in", "effects": [ { "type": "happiness", "amount": 3 }, { "type": "memory", "kind": "half_sibling", "to": "target", "text": "The day my half sister knocked on the door", "impact": -5 } ],
        "result": "She stays for four hours. You show her baby photos. She shows you hers. You have the same laugh." },
      { "text": "Call {t.name}", "effects": [ { "type": "relation", "who": "player", "to": "target", "dim": "trust", "amount": -20 } ],

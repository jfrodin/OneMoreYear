        "failure": { "text": "Number fourteen. You buy a blender you do not need, out of spite.", "effects": [ { "type": "money", "amount": -500 }, { "type": "happiness", "amount": -2 } ] } },
      { "text": "Stay in bed with leftovers", "effects": [ { "type": "happiness", "amount": 3 } ], "result": "A turkey sandwich at ten in the morning, in your pajamas. This is what freedom feels like." }

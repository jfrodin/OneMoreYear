    "choices": [ { "trait": "charming", "text": "Say something unforgettable",
      "effects": [ { "type": "start_dating", "to": "target" }, { "type": "happiness", "amount": 10 } ],
      "result": "One line, perfectly timed. {t.name} writes {t.his} number on your hand." } ] },
  { "event": "adult_temptation",
    "insights": [
      { "trait": "loyal", "text": "You think of {p.name} at home, making dinner. The thought is enough." },

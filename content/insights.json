      "result": "Three chords and the truth. There is not a dry eye in the room." } ] },
  { "event": "child_new_kid",
    "choices": [ { "trait": "kind", "text": "Show the new kid around",
      "effects": [ { "type": "happiness", "amount": 5 }, { "type": "trait_add", "trait": "social", "chance": 0.1 } ],

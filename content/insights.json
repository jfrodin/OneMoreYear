  { "event": "old_grandchild_money",
    "insights": [ { "trait": "paranoid", "text": "It's the third \"just this once\" this year." } ] },
  { "event": "old_new_love",
    "insights": [ { "trait": "cheerful", "text": "Seventy is just a number. Your heart doesn't know how to count." } ] },
  { "event": "assault_player",

  { "event": "old_car_keys",
    "insights": [ { "trait": "vain", "text": "Giving up the car means admitting you're old. You're not old. Everyone else is just young." } ] },
  { "event": "life_marathon",
    "insights": [ { "attribute": "fitness", "min": 70, "text": "Forty-two kilometres is a lot. But you've done twenty-five without noticing." } ] },
  { "event": "work_own_business",

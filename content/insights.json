      "result": "The music stops. Then starts again, louder. War has been declared." },
      { "trait": "social", "text": "Go to the party",
      "effects": [ { "type": "happiness", "amount": 7 } ], "result": "If you can't beat them, join them. Best Tuesday in years." } ] },
  { "event": "life_friend_loan",
    "insights": [
      { "trait": "stingy", "text": "You calculate the interest you'd be losing. It's not a small number." },
      { "trait": "generous", "text": "Money is only money. {t.name} is {t.name}." } ] },
  { "event": "life_speeding",
    "choices": [ { "trait": "charming", "text": "Smile, and tell the story about the sick aunt",
      "chance": 0.7, "success": { "text": "The officer laughs despite himself. A warning.", "effects": [] },
      "failure": { "text": "He's heard the aunt story before. Twice this week.", "effects": [ { "type": "money", "amount": -3500 } ] } } ] },
  { "event": "old_scam",
    "insights": [
      { "trait": "paranoid", "text": "The bank never calls. The bank has never, ever called." },

  { "event": "adult_stock_tip",
    "insights": [ { "attribute": "smarts", "min": 70, "text": "The \"sure thing\" has had three different CEOs in a year. Nobody mentions that." } ] },
  { "event": "partner_control",
    "insights": [
      { "trait": "brave", "text": "You know exactly what this is. You've read about it. The word is \"control\"." },
      { "trait": "conflict_averse", "text": "It's easier to just tell {t.him} where you've been. It's always easier." } ] },
  { "event": "jealous_partner",
    "insights": [ { "trait": "paranoid", "text": "Maybe {t.name} is right to worry. Maybe everyone is hiding something. Even you." } ] },
  { "event": "work_office_party",
    "insights": [ { "trait": "social", "text": "You know everyone's name, their children's names, and who is secretly seeing whom." } ],
    "choices": [ { "trait": "ambitious", "text": "Spend the evening with the CEO",
      "effects": [ { "type": "performance", "amount": 10 } ], "result": "Two drinks and a long talk about sailing. On Monday, the CEO says hello to you by name." } ] },
  { "event": "work_gossip",

// Passive checks, in the spirit of Disco Elysium: what a person's traits and gifts let them notice,
// shown under an event's text – and choices that only occur to people with a certain trait.
// Each entry adds to an existing event. Text uses the event's placeholders ({t.name} etc.).
[
  { "event": "child_parents_fight",
    "insights": [
      { "trait": "paranoid", "text": "It isn't about the dishes. It's about money. You heard the word \"bank\" three times." },
      { "trait": "kind", "text": "{o.name} is crying, very quietly, so you won't hear. You hear anyway." } ] },
  { "event": "child_bully",
    "insights": [ { "attribute": "smarts", "min": 70, "text": "The bully only does it when the teacher is on the other side of the yard. He's scared too." } ],
    "choices": [ { "trait": "charming", "text": "Make them laugh instead",
      "chance": 0.6, "success": { "text": "One joke at exactly the right moment, and suddenly you're the funny kid, not the target.", "effects": [ { "type": "happiness", "amount": 8 } ] },
      "failure": { "text": "Nobody laughs. It gets worse before it gets better.", "effects": [ { "type": "happiness", "amount": -6 } ] } } ] },
  { "event": "teen_party",
    "insights": [
      { "trait": "introvert", "text": "The best conversation at the party is happening on the back steps, where it's quiet." },
      { "trait": "impulsive", "text": "Someone has dared someone else to jump from the garage roof. It sounds like a great idea." } ] },
  { "event": "teen_smoking",
    "insights": [ { "trait": "hypochondriac", "text": "You can practically feel your lungs turning black from here." } ] },
  { "event": "teen_exams",
    "insights": [ { "attribute": "smarts", "min": 75, "text": "You recognise the question. It's in the book, page 214, in the margin nobody reads." } ] },
  { "event": "adult_meet_someone",
    "insights": [
      { "trait": "paranoid", "text": "Why is {t.name} asking so many questions about where you work?" },

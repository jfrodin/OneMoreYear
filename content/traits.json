// Traits are mechanics, not labels. Modifiers are read by the simulation:
//   career      – job performance and promotions        social     – finding partners and friends
//   spending    – lower savings rate (negative = saves)  conflict   – starts fights
//   infidelity  – chance to have affairs                loyalty    – forgives, stays, reconciles
//   divorce     – chance to leave a partner             grudge     – bitterness fades slower
//   envy        – envy towards richer relatives         health     – yearly health change
//   risk        – accidents and mortality               happiness  – shifts everyday mood (points)
//   warmth      – people grow closer to them            trust_decay – slowly trusts everyone less
//   parenting   – closer bond with their children       resilience – shrugs off trauma, heals faster
//   addiction   – risk of alcohol, drugs, gambling      violence   – may hurt partner or children
//   predatory   – danger to children (abuse storylines) crime      – drawn to crime
//   dishonesty  – lies, steals, hides things            jealousy   – possessive about a partner
//   greed       – fights over money and inheritance     charm      – good at winning people over
//   prefers_younger / prefers_older – falls for much younger / older adults (never minors)
// tone: light, dark or odd (colour in the UI). weight: how common the trait is (default 1).
// adultOnly traits are rolled at 18; maleWeight/femaleWeight skew how common they are by sex.
// inherit: chance that a child picks the trait up from a parent who has it (default 0.3). Low for
// traits that should not pile up in one family line (predatory).
[
  { "id": "ambitious", "name": "Ambitious", "opposite": "lazy", "tone": "light",
    "description": "Always wants more. Performs better at work, but compares themselves to others.",
    "modifiers": { "career": 0.5, "envy": 0.3 } },
  { "id": "lazy", "name": "Lazy", "opposite": "ambitious", "tone": "dark",
    "description": "Takes it easy. Rarely climbs the career ladder.",
    "modifiers": { "career": -0.5, "health": -0.2 } },
  { "id": "stingy", "name": "Stingy", "opposite": "generous", "tone": "odd",
    "description": "Saves every penny and hates lending money.",
    "modifiers": { "spending": -0.15, "envy": 0.2 } },
  { "id": "generous", "name": "Generous", "opposite": "stingy", "tone": "light",
    "description": "Happy to share, sometimes more than the wallet can take.",
    "modifiers": { "spending": 0.1, "loyalty": 0.2, "warmth": 0.3 } },
  { "id": "loyal", "name": "Loyal", "opposite": "unfaithful", "tone": "light",
    "description": "Stays when things get rough. Forgives more easily and rarely leaves.",
    "modifiers": { "loyalty": 1.0, "divorce": -1.0, "infidelity": -1.0 } },
  { "id": "impulsive", "name": "Impulsive", "tone": "odd",
    "description": "Acts first, thinks later. Exciting, but risky.",
    "modifiers": { "risk": 0.5, "divorce": 0.5, "spending": 0.15, "conflict": 0.5, "infidelity": 0.3, "addiction": 0.3 } },
  { "id": "social", "name": "Social", "opposite": "introvert", "tone": "light",
    "description": "Thrives around people and easily finds new friends and partners.",
    "modifiers": { "social": 0.5 } },
  { "id": "introvert", "name": "Introverted", "opposite": "social", "tone": "odd",
    "description": "Needs peace and quiet. Few but deep relationships.",
    "modifiers": { "social": -0.4, "conflict": -0.3 } },
  { "id": "brave", "name": "Brave", "opposite": "conflict_averse", "tone": "light",
    "description": "Dares to fight and take chances.",
    "modifiers": { "risk": 0.3, "conflict": 0.2 } },
  { "id": "conflict_averse", "name": "Conflict-averse", "opposite": "brave", "tone": "odd",

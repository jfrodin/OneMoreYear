// Achievements (docs/endgame.md). The rules are in AchievementSystem.cs, by id.
// Common ones are shown in full. Rare and legendary ones show only the hint until unlocked.
// Secret ones are not shown at all until they happen. No dashes.
[
  { "id": "married", "tier": "common", "name": "I do",
    "text": "Somebody cried, somebody's uncle gave a speech that went on too long, and two people promised each other everything." },
  { "id": "graduate", "tier": "common", "name": "The first with a degree",
    "text": "A diploma in a frame, and a photograph of a parent standing very straight next to it." },
  { "id": "home_owner", "tier": "common", "name": "Keys of your own",
    "text": "A door that nobody else can tell you to leave." },
  { "id": "grandparent", "tier": "common", "name": "The next one",
    "text": "A grandchild. All the love, and you get to give them back at the end of the day." },
  { "id": "next_generation", "tier": "common", "name": "The story goes on",
    "text": "One life ended. The family did not." },
  { "id": "centenarian", "tier": "rare", "name": "A hundred candles",
    "hint": "Blow them out in one breath. All of them.",
    "text": "A hundred years. A letter from someone important, and a cake nobody dares to light all at once." },
  { "id": "dreamer", "tier": "common", "name": "A dream come true",
    "text": "One thing, at the end, that made it all worth it. You got it." },
  { "id": "emigrant", "tier": "common", "name": "Two suitcases",
    "text": "Everything you owned, everything you knew, and a ticket that only went one way." },

  { "id": "five_generations", "tier": "rare", "name": "Five generations",
    "hint": "Somebody has to hold the baby. Somebody has to hold the oldest.",
    "text": "Five generations alive at once. Somebody holds the baby for the photo, and somebody holds the great great grandmother." },
  { "id": "three_doctors", "tier": "legendary", "name": "A family of doctors",
    "hint": "Like father, like daughter, like grandson.",
    "text": "Three generations in white coats. At Christmas nobody can mention a symptom without a second opinion." },
  { "id": "debt_to_riches", "tier": "rare", "name": "From debt to riches",
    "hint": "The bottom, and then the top, in one lifetime.",
    "text": "Once the bank called every week. Now the bank sends flowers." },
  { "id": "no_divorce", "tier": "rare", "name": "Till death",
    "hint": "Four generations of keeping a promise.",
    "text": "Four generations, and every one of them stayed. Not always happily. But they stayed." },
  { "id": "hundred_years", "tier": "common", "name": "A hundred years of us",
    "hint": "Keep the story going for a century.",
    "text": "A hundred years of one family. Wars, crashes, weddings and funerals, and still a table with all of you around it." },
  { "id": "golden_wedding", "tier": "rare", "name": "Fifty years",
    "hint": "Gold, after half a century.",
    "text": "Fifty years married. They still argue about how to load the dishwasher, and they still hold hands in the car." },
  { "id": "inherited_dream", "tier": "rare", "name": "For both of us",
    "hint": "Finish what someone else started.",
    "text": "A parent's dream that never came true, and a child who made it come true anyway." },
  { "id": "household_name", "tier": "rare", "name": "A household name",
    "hint": "Make it in music, books, paint or sport, and keep going until everyone knows your name.",
    "text": "Strangers know your face, your voice, your story. Taxi drivers have opinions about you." },
  { "id": "famous_family", "tier": "legendary", "name": "That family",
    "hint": "Three of the lives you play known across the country.",
    "text": "People say the surname and other people nod. Talent, they say, runs in that family. So does trouble." },
  { "id": "wish_a_year", "tier": "rare", "name": "Small things",
    "hint": "Want something small every year, and get it. Forty times in one life.",
    "text": "Forty years of small wishes kept: a phone call, a walk, a dinner. Most of a life is made of them." },
  { "id": "century_heirloom", "tier": "rare", "name": "Kept",
    "hint": "Something small, held on to for a hundred years, and in your hands at the end of them.",
    "text": "A hundred years in the family, never sold, never lost. Every owner wrote a line in its story." },
  { "id": "published", "tier": "rare", "name": "In print",
    "hint": "Years of evenings, three hundred pages, and somebody else saying yes.",
    "text": "Your name on a cover in a shop window. You walked past it four times in one afternoon." },
  { "id": "family_firm", "tier": "rare", "name": "The family firm",
    "hint": "Three owners, one name over the door, and two of them were you.",
    "text": "Three generations behind the same counter. The sign has been repainted twice. The name has never changed." },
  { "id": "full_circle", "tier": "rare", "name": "Full circle",
    "hint": "Someone left. Someone else went back.",
    "text": "An ancestor left this country with two suitcases. Generations later, someone came back to it." },

  { "id": "ten_generations", "tier": "legendary", "name": "Ten generations",
    "hint": "Very few families remember who they were ten lives ago.",
    "text": "Ten generations. The first of you would not recognise the world the last of you lives in, and would recognise the family at once." },
  { "id": "dynasty", "tier": "legendary", "name": "Dynasty",
    "hint": "Fifty living reasons to remember one name.",
    "text": "Fifty living descendants of the first of you. The family reunion needs a field, and name tags." },
  { "id": "from_nothing", "tier": "legendary", "name": "From nothing",
    "hint": "Start with the hardest life. End among the richest.",
    "text": "A rented flat, a debt and a bottle in the cupboard. Then, generations later, one of the richest families in the land." },
  { "id": "clean_record", "tier": "legendary", "name": "Clean hands",
    "hint": "Seven generations without a cell, a lie in someone else's bed, or a broken vow.",
    "text": "Seven generations without a crime, an affair or a divorce. Saints are rare. A family of them is unheard of." },
  { "id": "two_centuries", "tier": "rare", "name": "Two hundred years",
    "hint": "Longer than most countries have had their borders.",
    "text": "Two hundred years of one family. Somewhere in a drawer, there is still a photograph of the first of you." },

  { "id": "the_return", "tier": "secret", "name": "The way back",
    "text": "You left, and years later you came home. The street was the same. You were not." },
  { "id": "full_table", "tier": "secret", "name": "A full table",
    "text": "Seven children or more. Every meal is an event, and every name is called twice before the right one." },
  { "id": "survivor", "tier": "secret", "name": "The last one left",
    "text": "No parent should bury a child. You buried all of yours, and kept getting up in the morning." },
  { "id": "cell_to_corner_office", "tier": "secret", "name": "From the cell to the corner office",
    "text": "Years behind bars, and then the top of the ladder. Some people at work know. Nobody says a thing." },
  { "id": "myth_true", "tier": "secret", "name": "The rumour was true",
    "text": "Every family has a story nobody believes. Yours turned out to be true, and worse." },
  { "id": "family_book", "tier": "secret", "name": "The family book",
    "text": "Eight generations, bound in one book. Somewhere in it is every one of you who got this far." },
  { "id": "bought_back", "tier": "secret", "name": "Back where it belongs",
    "text": "It left the family once. You found it again, and paid what it took to bring it home." },
  { "id": "one_hundred_ten", "tier": "secret", "name": "A hundred and ten",
    "text": "A hundred and ten years. The doctors have stopped giving advice and started asking for it." }
]
